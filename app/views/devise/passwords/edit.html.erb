<%# Reset Password %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-heading">Restablecer contraseña</h1>
    </div>

    <div class="bg-white rounded-badge border border-border shadow-raised p-6 md:p-8">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div>
          <%= f.label :password, "Nueva contraseña", class: "block text-sm font-medium text-body mb-1" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-muted mb-1">(<%= @minimum_password_length %> caracteres mínimo)</p>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar nueva contraseña", class: "block text-sm font-medium text-body mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
        </div>

        <%= f.submit "Restablecer contraseña",
            class: "w-full px-6 py-2.5 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-border">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
