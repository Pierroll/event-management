<%# Register Page %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Crear cuenta</h1>
      <p class="mt-2 text-gray-500">Regístrate en SGE para gestionar eventos</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 md:p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">Tipo de cuenta</label>
          <div class="grid grid-cols-2 gap-4">
            <label class="relative flex flex-col items-center gap-2 p-4 border-2 border-gray-100 rounded-xl cursor-pointer hover:bg-gray-50 transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 group">
              <%= f.radio_button :selected_role, "registered_user", 
                  checked: params[:role] != "organizer", 
                  class: "sr-only" %>
              <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 group-hover:scale-110 transition-transform peer-checked:bg-blue-500 peer-checked:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-500">Asistente</span>
            </label>

            <label class="relative flex flex-col items-center gap-2 p-4 border-2 border-gray-100 rounded-xl cursor-pointer hover:bg-gray-50 transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 group">
              <%= f.radio_button :selected_role, "organizer", 
                  checked: params[:role] == "organizer", 
                  class: "sr-only" %>
              <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 group-hover:scale-110 transition-transform peer-checked:bg-blue-500 peer-checked:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-500">Organizador</span>
            </label>
          </div>
        </div>

        <div>
          <%= f.label :name, "Nombre completo", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name",
              class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "Ej: Juan Pérez" %>
        </div>

        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autocomplete: "email",
              class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "correo@ejemplo.com" %>
        </div>

        <div>
          <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-400 mb-1">(<%= @minimum_password_length %> caracteres mínimo)</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <%= f.submit "Registrarse",
            class: "w-full px-6 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
