<%# Register Page %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-heading">Crear cuenta</h1>
      <p class="mt-2 text-body-tertiary">Unite a SGE y empezá a disfrutar de eventos únicos</p>
    </div>

    <div class="bg-white rounded-badge border border-border shadow-raised p-6 md:p-8" data-controller="registration">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <label class="block text-sm font-medium text-body mb-3">Elige tu tipo de cuenta</label>
          <div class="grid grid-cols-2 gap-4">
            <%# Asistir %>
            <%= f.label :selected_role, value: "registered_user", class: "relative flex flex-col items-center gap-2 p-4 border-2 border-border-light rounded-badge cursor-pointer hover:bg-surface-secondary transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-raised group" do %>
              <%= f.radio_button :selected_role, "registered_user", class: "role-radio sr-only" %>
              <div class="w-10 h-10 bg-surface-secondary rounded-card flex items-center justify-center text-muted group-has-[:checked]:bg-primary/100 group-has-[:checked]:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <span class="text-sm font-bold tracking-wider text-body">Asistir</span>
              <p class="text-[11px] text-muted text-center leading-snug">Comprar entradas y descubrir eventos cerca de ti</p>
            <% end %>

            <%# Organizar %>
            <%= f.label :selected_role, value: "organizer", class: "relative flex flex-col items-center gap-2 p-4 border-2 border-border-light rounded-badge cursor-pointer hover:bg-surface-secondary transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/10 has-[:checked]:shadow-raised group" do %>
              <%= f.radio_button :selected_role, "organizer", class: "role-radio sr-only" %>
              <div class="w-10 h-10 bg-surface-secondary rounded-card flex items-center justify-center text-muted group-has-[:checked]:bg-primary/100 group-has-[:checked]:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <span class="text-sm font-bold tracking-wider text-body">Organizar</span>
              <p class="text-[11px] text-muted text-center leading-snug">Crear y vender tickets para tus propios eventos</p>
            <% end %>
          </div>
          <p class="text-xs text-error mt-2 hidden" id="role-error">Seleccioná un tipo de cuenta para continuar</p>
        </div>

        <div>
          <%= f.label :name, "Nombre completo", class: "block text-sm font-medium text-body mb-1" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary",
              placeholder: "Ej: Juan Pérez" %>
        </div>

        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-body mb-1" %>
          <%= f.email_field :email, autocomplete: "email",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary",
              placeholder: "correo@ejemplo.com" %>
        </div>

        <div>
          <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-body mb-1" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-muted mb-1">(<%= @minimum_password_length %> caracteres mínimo)</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-medium text-body mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
        </div>

        <%= f.button "Registrarse",
            id: "register-submit-btn",
            disabled: true,
            class: "w-full px-6 py-2.5 bg-primary/50 text-white text-sm font-medium rounded-card transition-all duration-200 cursor-not-allowed" %>
      <% end %>

      <%# Google OAuth — requires role selection %>
      <div class="mt-6 pt-6 border-t border-border">
        <div class="relative mb-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-border"></div>
          </div>
          <div class="relative flex justify-center text-xs">
            <span class="bg-white px-3 text-muted">ó registrate con</span>
          </div>
        </div>

        <%= button_to user_google_oauth2_authorize_with_role_path,
            params: { selected_role: "" },
            method: :post,
            class: "w-full flex items-center justify-center gap-3 px-6 py-2.5 border border-border text-sm font-medium rounded-card transition-all duration-200 cursor-not-allowed",
            form_class: "w-full",
            id: "google-register-btn",
            disabled: true,
            data: { turbo: false } do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continuar con Google
        <% end %>

        <p class="text-xs text-muted text-center mt-3">Primero elegí si querés <strong>Asistir</strong> u <strong>Organizar</strong> para habilitar el registro con Google</p>
      </div>

      <div class="mt-4 text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  (function() {
    const radios = document.querySelectorAll(".role-radio");
    const registerBtn = document.getElementById("register-submit-btn");
    const googleBtn = document.getElementById("google-register-btn");
    const roleError = document.getElementById("role-error");
    const hiddenInput = googleBtn?.closest("form")?.querySelector("input[name='selected_role']");

    function toggleButtons() {
      const selected = document.querySelector(".role-radio:checked");
      const hasRole = selected !== null;

      // Register button: azul claro deshabilitado, azul fuerte habilitado
      if (registerBtn) {
        registerBtn.disabled = !hasRole;
        registerBtn.classList.toggle("cursor-not-allowed", !hasRole);
        registerBtn.classList.toggle("bg-primary/50", !hasRole);
        registerBtn.classList.toggle("bg-primary", hasRole);
        registerBtn.classList.toggle("hover:bg-primary-hover", hasRole);
      }

      // Google button: gris deshabilitado, blanco habilitado
      if (googleBtn) {
        googleBtn.disabled = !hasRole;
        googleBtn.classList.toggle("cursor-not-allowed", !hasRole);
        googleBtn.classList.toggle("border-border", !hasRole);
        googleBtn.classList.toggle("border-border-input", hasRole);
        googleBtn.classList.toggle("bg-surface-secondary", !hasRole);
        googleBtn.classList.toggle("bg-white", hasRole);
        googleBtn.classList.toggle("text-muted", !hasRole);
        googleBtn.classList.toggle("text-body", hasRole);
        googleBtn.classList.toggle("hover:bg-surface-secondary", hasRole);
      }

      if (roleError) {
        roleError.classList.toggle("hidden", hasRole);
      }

      if (hiddenInput && selected) {
        hiddenInput.value = selected.value;
      }
    }

    radios.forEach(function(radio) {
      radio.addEventListener("change", toggleButtons);
    });

    toggleButtons();
  })();
<% end %>
