<%# Login Page %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-heading">Iniciar sesión</h1>
      <p class="mt-2 text-body-tertiary">Accede a tu cuenta de Actify</p>
    </div>

    <div class="bg-white rounded-badge border border-border shadow-raised p-6 md:p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5", data: { turbo: false } }) do |f| %>
        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-body mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
        </div>

        <div>
          <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-body mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full border border-border-input rounded-input px-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-link focus:ring-primary border-border-input rounded" %>
            <%= f.label :remember_me, "Recordar sesión", class: "text-sm text-body-secondary" %>
          </div>
        <% end %>

        <%= f.submit "Iniciar sesión",
            class: "w-full px-6 py-2.5 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-border">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post,
            class: "w-full flex items-center justify-center gap-3 px-6 py-2.5 border border-border-input text-sm font-medium rounded-card hover:bg-surface-secondary transition-colors mb-4",
            form_class: "w-full",
            data: { turbo: false } do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Ingresar con Google
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
