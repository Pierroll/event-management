<% content_for :title, "Comprar entrada — #{@event.name}" %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Comprar entrada</h1>

  <!-- Event Summary -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-2"><%= @event.name %></h2>
    <div class="space-y-3 text-sm text-gray-600">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span><%= l(@event.start_date, format: :long) %> — <%= l(@event.end_date, format: :long) %></span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span><%= @event.city %> — <%= @event.address %></span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-lg font-semibold text-blue-600"><%= number_to_currency @event.price, unit: "S/ " %> por persona</span>
      </div>
      <div class="flex items-center gap-2">
        <% if @event.sold_out? %>
          <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-red-600 font-semibold">Agotado</span>
        <% else %>
          <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-green-600"><%= @event.remaining_capacity %> lugares disponibles</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Booking Form -->
  <% if @event.available? %>
    <%= form_with model: [@event, @booking], class: "space-y-6" do |f| %>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Cantidad de entradas
        </label>
        <%= f.number_field :quantity,
              value: 1,
              min: 1,
              max: @event.remaining_capacity,
              class: "w-32 px-4 py-2 border border-gray-300 rounded-xl text-center text-lg font-semibold focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        <p class="text-xs text-gray-400 mt-1">Máximo <%= @event.remaining_capacity %> entradas</p>

        <div class="mt-6 p-4 bg-gray-50 rounded-xl">
          <div class="flex justify-between items-center">
            <span class="text-gray-600">Total estimado</span>
            <span id="total-price" class="text-xl font-bold text-blue-600">
              <%= number_to_currency @event.price, unit: "S/ " %>
            </span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <%= f.submit "Confirmar compra",
              class: "px-8 py-3 bg-blue-600 text-white text-sm font-semibold rounded-xl hover:bg-blue-700 transition-colors cursor-pointer" %>
        <%= link_to "Cancelar", @event, class: "text-sm text-gray-500 hover:text-gray-700" %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
      <p class="text-red-700 font-semibold">Este evento no tiene entradas disponibles.</p>
      <%= link_to "Volver al evento", @event, class: "mt-4 inline-block text-sm text-blue-600 hover:text-blue-800" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('input', function(e) {
    if (e.target.id === 'booking_quantity') {
      const price = <%= @event.price %>;
      const qty = parseInt(e.target.value) || 1;
      document.getElementById('total-price').textContent = 'S/ ' + (price * qty).toFixed(2);
    }
  });
</script>
