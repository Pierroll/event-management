<% content_for :title, "Comprar entrada — #{@event.name}" %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-heading mb-6">Comprar entrada</h1>

  <!-- Event Summary -->
  <div class="bg-white rounded-2xl shadow-raised border border-border p-6 mb-6">
    <h2 class="text-lg font-semibold text-heading mb-2"><%= @event.name %></h2>
    <div class="space-y-3 text-sm text-body-secondary">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span><%= l(@event.start_date, format: :long) %><%= @event.end_date.present? ? " — #{l(@event.end_date, format: :long)}" : "" %></span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span><%= @event.city %> — <%= @event.address %></span>
      </div>
      <% if @ticket_type %>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-lg font-semibold text-link"><%= number_to_currency @ticket_type.price, unit: "S/ " %> por persona · <%= @ticket_type.name %></span>
        </div>
      <% else %>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Seleccioná un tipo de entrada abajo</span>
        </div>
      <% end %>
      <div class="flex items-center gap-2">
        <% if @event.sold_out? %>
          <svg class="w-5 h-5 text-error shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-error font-semibold">Agotado</span>
        <% else %>
          <svg class="w-5 h-5 text-success shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-success"><%= @event.remaining_capacity %> lugares disponibles</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Ticket Type Selector (if not already selected) -->
  <% if @ticket_type.nil? && @ticket_types.many? %>
    <div class="bg-white rounded-2xl shadow-raised border border-border p-6 mb-6">
      <h3 class="text-sm font-medium text-body mb-3">Elegí tu tipo de entrada</h3>
      <div class="space-y-2">
        <% @ticket_types.each do |tt| %>
          <%= link_to new_event_booking_path(@event, ticket_type_id: tt.id),
              class: "block p-3 border border-border rounded-badge hover:border-primary hover:bg-primary/10 transition-all #{'border-primary bg-primary/10' if @ticket_type == tt}" do %>
            <div class="flex justify-between items-center">
              <span class="font-medium text-heading"><%= tt.name %></span>
              <span class="font-semibold text-link"><%= tt.price > 0 ? number_to_currency(tt.price, unit: "S/ ") : "Gratis" %></span>
            </div>
            <p class="text-xs text-body-tertiary mt-0.5"><%= tt.remaining_capacity %> disponibles</p>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Booking Form -->
  <% if @ticket_type && @event.available? %>
    <%= form_with model: [@event, @booking], class: "space-y-6" do |f| %>
      <%= hidden_field_tag :ticket_type_id, @ticket_type.id %>

      <div class="bg-white rounded-2xl shadow-raised border border-border p-6">
        <label class="block text-sm font-medium text-body mb-2">
          Cantidad de entradas
        </label>
        <%= f.number_field :quantity,
              value: 1,
              min: 1,
              max: @ticket_type.max_purchasable_now,
              class: "w-32 px-4 py-2 border border-border-input rounded-badge text-center text-lg font-semibold focus:ring-2 focus:ring-primary focus:border-primary" %>
        <p class="text-xs text-muted mt-1">
          Máximo <%= @ticket_type.max_purchasable_now %> entradas
          <% if @ticket_type.max_per_order.present? %>
            · máx. <%= @ticket_type.max_per_order %> por persona
          <% end %>
        </p>

        <div class="mt-6 p-4 bg-surface-secondary rounded-badge">
          <div class="flex justify-between items-center">
            <span class="text-body-secondary">Total estimado</span>
            <span id="total-price" class="text-xl font-bold text-link">
              <%= number_to_currency @ticket_type.price, unit: "S/ " %>
            </span>
          </div>
        </div>
      </div>

      <%# PoC Cross-Selling Addon (Checkout Phase) %>
      <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-6 shadow-sm relative overflow-hidden group">
        <div class="absolute -right-6 -top-6 text-indigo-100 group-hover:scale-110 transition-transform duration-500">
          <svg class="w-32 h-32" fill="currentColor" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
        <div class="relative z-10 flex items-start gap-4">
          <input type="checkbox" id="hotel_addon" class="mt-1 w-5 h-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer" onclick="alert('PoC Arquitectura: En el flujo real, al confirmar la compra, Event Management enviará un POST/Webhook a la Plataforma 2 (Hoteles) confirmando este Add-on, cobrando ambos servicios en un solo carrito via Culqi.')">
          <div>
            <label for="hotel_addon" class="text-sm font-bold text-indigo-900 block cursor-pointer">
              Experiencia Completa: Añadir Noche de Hotel (+ S/ 85.00)
            </label>
            <p class="text-xs text-indigo-800 mt-1">
              Desbloquea 10% de descuento en "Boutique Stay" exclusivo por asistir a <strong><%= @event.name %></strong>.
            </p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <%= f.submit "Confirmar compra",
              class: "px-8 py-3 bg-primary text-white text-sm font-semibold rounded-badge hover:bg-primary-hover transition-colors cursor-pointer" %>
        <%= link_to "Cancelar", @event, class: "text-sm text-body-tertiary hover:text-body" %>
      </div>
    <% end %>
  <% elsif !@ticket_type && @ticket_types.many? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 text-center">
      <p class="text-yellow-700 font-semibold">Seleccioná un tipo de entrada para continuar.</p>
    </div>
  <% elsif @event.available? && @ticket_types.one? %>
    <%# Solo un tipo disponible, redirigimos silenciosamente - no debería llegar acá %>
  <% else %>
    <div class="bg-error/10 border border-error/30 rounded-2xl p-6 text-center">
      <p class="text-error font-semibold">Este evento no tiene entradas disponibles.</p>
      <%= link_to "Volver al evento", @event, class: "mt-4 inline-block text-sm text-link hover:text-link" %>
    </div>
  <% end %>
</div>

<% if @ticket_type %>
<script>
  document.addEventListener('input', function(e) {
    if (e.target.id === 'booking_quantity') {
      const price = <%= @ticket_type.price %>;
      const qty = parseInt(e.target.value) || 1;
      document.getElementById('total-price').textContent = 'S/ ' + (price * qty).toFixed(2);
    }
  });
</script>
<% end %>
