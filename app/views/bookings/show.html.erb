<% if @booking.confirmed? %>
  <% content_for :title, "Compra confirmada — #{@booking.event.name}" %>
<% elsif @booking.pending? %>
  <% content_for :title, "Pago pendiente — #{@booking.event.name}" %>
<% elsif @booking.expired? %>
  <% content_for :title, "Reserva expirada — #{@booking.event.name}" %>
<% else %>
  <% content_for :title, "Reserva cancelada — #{@booking.event.name}" %>
<% end %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow-raised border border-border p-8 text-center">
    <% if @booking.confirmed? %>
      <!-- Success Icon -->
      <div class="mx-auto w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-heading mb-2">¡Compra confirmada!</h1>
      <p class="text-body-tertiary mb-8">Tu entrada ha sido registrada exitosamente.</p>
    <% elsif @booking.pending? %>
      <!-- Pending/Warning Icon -->
      <div class="mx-auto w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-heading mb-2">Pago pendiente</h1>
      <p class="text-body-tertiary mb-8">
        Completá el pago para confirmar tus entradas. Tu reserva expira en:
        <span class="font-mono font-bold text-heading text-lg"
              data-controller="checkout-timer"
              data-checkout-timer-expires-at-value="<%= @booking.expires_at.iso8601 %>"
              data-checkout-timer-target="display">
          --:--
        </span>
      </p>
    <% elsif @booking.expired? %>
      <!-- Expired Icon -->
      <div class="mx-auto w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-heading mb-2">Reserva expirada</h1>
      <p class="text-body-tertiary mb-8">El tiempo para completar el pago de esta reserva ha expirado.</p>
    <% else %>
      <!-- Canceled Icon -->
      <div class="mx-auto w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-heading mb-2">Reserva cancelada</h1>
      <p class="text-body-tertiary mb-8">Esta reserva ha sido cancelada.</p>
    <% end %>

    <!-- Booking Details -->
    <div class="bg-surface-secondary rounded-badge p-6 text-left space-y-3 mb-8">
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
          Evento
        </span>
        <span class="font-semibold text-heading"><%= @booking.event.name %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Fecha
        </span>
        <span class="text-heading"><%= l @booking.event.start_date, format: :long %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Ciudad
        </span>
        <span class="text-heading"><%= @booking.event.city %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Entradas
        </span>
        <span class="font-semibold text-heading"><%= @booking.quantity %></span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Total
        </span>
          <span class="font-semibold text-link">
            <%= number_to_currency @booking.total_price, unit: "S/ " %>
          </span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <% if @booking.confirmed? %>
            <svg class="w-4 h-4 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% elsif @booking.pending? %>
            <svg class="w-4 h-4 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% else %>
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
          Estado
        </span>
        <% if @booking.confirmed? %>
          <span class="text-success font-semibold">Confirmado</span>
        <% elsif @booking.pending? %>
          <span class="text-yellow-600 font-semibold">Pendiente de pago</span>
        <% elsif @booking.expired? %>
          <span class="text-red-600 font-semibold">Expirado</span>
        <% else %>
          <span class="text-gray-600 font-semibold">Cancelado</span>
        <% end %>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-body-tertiary flex items-center gap-2">
          <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Comprado el
        </span>
        <span class="text-heading"><%= l @booking.booked_at, format: :long %></span>
      </div>
    </div>

    <!-- Individual Tickets -->
    <% if @booking.confirmed? && @booking.tickets.any? %>
      <div class="mt-8 pt-8 border-t border-border">
        <h2 class="text-lg font-semibold text-heading mb-4">Tus entradas</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% @booking.tickets.each_with_index do |ticket, i| %>
            <div class="<%= ticket.active? ? 'bg-white border border-border' : 'bg-surface-secondary border border-border opacity-60' %> rounded-badge p-4 text-center">
              <div class="mb-3 inline-block">
                <%= qr_code_svg(ticket.qr_code, module_size: 3) %>
              </div>
              <% if @booking.tickets.count > 1 && ticket.active? %>
                <div class="mt-1 mb-3">
                  <%= form_with(model: ticket, url: ticket_path(ticket), method: :patch, local: true, class: "inline-block w-full") do |f| %>
                    <div class="flex items-center gap-1.5 justify-center max-w-[240px] mx-auto">
                      <%= f.text_field :attendee_name, value: ticket.attendee_name, placeholder: "Nombre del asistente", 
                                       class: "w-full text-xs px-3 py-1.5 border border-border-input rounded-input bg-surface-secondary text-body focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all text-center",
                                       id: "ticket_attendee_name_#{ticket.id}" %>
                      <%= f.button type: :submit, class: "p-2 bg-primary text-white rounded-input hover:bg-primary-hover active:scale-[0.95] transition-all flex items-center justify-center shrink-0 shadow-sm shadow-primary/10", title: "Guardar nombre", id: "submit_ticket_#{ticket.id}" do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-sm font-semibold text-heading mb-3">
                  <%= ticket.attendee_name.presence || "Entrada ##{i + 1}" %>
                </p>
              <% end %>
              <span class="<%= ticket.active? ? 'bg-success/10 text-success' : 'bg-surface-tertiary text-body-tertiary' %> text-xs font-medium px-2.5 py-0.5 rounded-full">
                <%= ticket.active? ? "Válida" : ticket.used? ? "Usada" : "Cancelada" %>
              </span>
              <p class="text-[10px] text-muted font-mono mt-2 break-all select-all"><%= ticket.qr_code %></p>

              <% if ticket.active? %>
                <div class="mt-4" data-controller="qr-modal">
                  <button type="button" data-action="click->qr-modal#open" 
                          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-surface-secondary hover:bg-surface-tertiary text-heading text-xs font-bold rounded-xl transition-all border border-border shadow-sm active:scale-97 w-full justify-center">
                    <svg class="w-4 h-4 text-body-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    Ampliar QR
                  </button>
                  
                  <%# Modal target %>
                  <div data-qr-modal-target="modal" 
                       class="hidden fixed inset-0 z-[250] items-center justify-center p-4 bg-gray-950/65 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-out">
                    <div class="modal-content scale-95 opacity-0 bg-white w-full max-w-sm rounded-3xl shadow-2xl overflow-hidden transition-[transform,opacity] duration-300 ease-out p-6 text-center">
                      <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold text-heading">Mi Entrada QR</h3>
                        <button type="button" data-action="click->qr-modal#close" 
                                class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-secondary text-muted hover:text-heading transition-colors">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                          </svg>
                        </button>
                      </div>
                      
                      <div class="bg-surface-secondary rounded-2xl p-6 mb-4 flex items-center justify-center border border-border-light shadow-inner">
                        <%= qr_code_svg(ticket.qr_code, module_size: 6) %>
                      </div>
                      
                      <div class="space-y-1">
                        <p class="text-base font-black text-heading">
                          <%= ticket.attendee_name.presence || "Entrada ##{i + 1}" %>
                        </p>
                        <p class="text-xs font-bold text-primary uppercase tracking-wider">
                          <%= @booking.ticket_type.name %>
                        </p>
                        <p class="text-[10px] text-muted font-mono pt-2 break-all select-all"><%= ticket.qr_code %></p>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <% if @booking.pending? && !@booking.expired_unpaid? %>
        <%= link_to "Pagar ahora (S/ #{@booking.total_price})", new_booking_payment_path(@booking), class: "px-6 py-3 bg-primary text-white font-semibold rounded-badge hover:bg-primary-hover transition-colors text-center" %>
      <% end %>
      <%= link_to "Ver mis reservas", bookings_path, class: "px-6 py-3 border border-border-input text-body font-semibold rounded-badge hover:bg-surface-secondary transition-colors text-center" %>
      <%= link_to "Volver al evento", @booking.event, class: "px-6 py-3 border border-border-input text-body font-semibold rounded-badge hover:bg-surface-secondary transition-colors text-center" %>
    </div>
  </div>
</div>
