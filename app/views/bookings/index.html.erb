<% content_for :title, "Mis entradas" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-heading mb-6">Mis entradas</h1>

  <% if @bookings.empty? %>
    <div class="bg-white rounded-2xl shadow-raised border border-border p-12 text-center">
      <div class="mx-auto w-16 h-16 bg-surface-secondary rounded-full flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-body mb-2">No tienes entradas aún</h2>
      <p class="text-body-tertiary mb-6">Explora los eventos disponibles y consigue tus entradas.</p>
      <%= link_to "Explorar eventos", events_path, class: "inline-block px-6 py-3 bg-primary text-white font-semibold rounded-badge hover:bg-primary-hover transition-colors" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @bookings.each do |booking| %>
        <%= link_to booking, class: "block bg-white rounded-2xl shadow-raised border border-border p-6 hover:border-primary hover:shadow-md transition-all" do %>
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-heading mb-1">
                <%= booking.event.name %>
              </h3>
              <div class="flex flex-wrap gap-4 text-sm text-body-tertiary">
                <span class="inline-flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <%= l booking.event.start_date, format: :short %>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <%= booking.event.city %>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                  </svg>
                  <%= booking.quantity %> entrada(s)
                </span>
                <span class="font-semibold text-link">
                  <%= number_to_currency booking.total_price, unit: "S/ " %>
                </span>
              </div>
            </div>
            <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= booking.confirmed? ? 'bg-success/10 text-success' : 'bg-surface-secondary text-body' %>">
              <%= t("bookings.status.#{booking.status}") %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= paginate @bookings %>
  <% end %>
</div>
