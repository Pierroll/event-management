<%# Comment Partial %>
<div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
        <span class="text-sm font-medium text-blue-700"><%= comment.user.name.first.upcase %></span>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-900"><%= comment.user.name %></p>
        <p class="text-xs text-gray-400"><%= l(comment.created_at, format: :short) %></p>
      </div>
    </div>
    <% if comment.rating.present? %>
      <div class="flex items-center gap-0.5">
        <% comment.rating.times do %>
          <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        <% end %>
        <% (5 - comment.rating).times do %>
          <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <p class="mt-3 text-sm text-gray-700 leading-relaxed"><%= comment.content %></p>

  <% if user_signed_in? && comment.user_id == current_user.id %>
    <div class="mt-3 flex justify-end">
      <%= button_to [@event, comment], method: :delete,
          class: "text-xs text-red-500 hover:text-red-700 transition-colors",
          data: { turbo_confirm: "¿Eliminar este comentario?" } do %>
        Eliminar
      <% end %>
    </div>
  <% end %>
</div>