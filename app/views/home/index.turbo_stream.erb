<%= turbo_stream.append "home_upcoming_events" do %>
  <%= render partial: "events/event_card", collection: @upcoming_events, as: :event %>
<% end %>

<%= turbo_stream.replace "home_load_more_button" do %>
  <%= turbo_frame_tag "home_load_more_button" do %>
    <% if @upcoming_events.next_page %>
      <div class="mt-10 flex justify-center">
        <%= link_to "Ver más", root_path(page: @upcoming_events.next_page, format: :turbo_stream), class: "btn-secondary bg-surface border border-border text-heading px-6 py-2 rounded-full hover:bg-surface-secondary transition-colors font-medium", data: { turbo_stream: true } %>
      </div>
    <% end %>
  <% end %>
<% end %>
