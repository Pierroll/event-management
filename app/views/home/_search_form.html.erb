<%= form_tag events_path, method: :get, class: "grid grid-cols-1 md:grid-cols-12 gap-3" do %>
  
  <%# 1. Palabra Clave (4 Cols) %>
  <div class="relative md:col-span-4">
    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </span>
    <%= text_field_tag :query, params[:query], 
        placeholder: "¿Qué querés hacer? (Ej: música)",
        class: "w-full pl-10 pr-3 py-3.5 bg-surface-secondary border border-border/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary focus:bg-white transition-all text-sm font-semibold text-heading placeholder-muted shadow-inner" %>
  </div>

  <%# 2. Categoría Dropdown (3 Cols) %>
  <div class="relative md:col-span-3">
    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </span>
    <%= select_tag :category_id,
        options_from_collection_for_select(navbar_categories, :id, :name, params[:category_id]),
        prompt: "Todas las categorías",
        class: "w-full pl-10 pr-8 py-3.5 bg-surface-secondary border border-border/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary focus:bg-white transition-all text-sm font-semibold text-heading placeholder-muted shadow-inner appearance-none cursor-pointer" %>
    <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-muted">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </div>

  <%# 3. Ciudad Input con Datalist Suggestions (3 Cols) %>
  <div class="relative md:col-span-3">
    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    </span>
    <%= text_field_tag :city, params[:city], 
        placeholder: "¿Dónde? (Ej: Lima)",
        list: "hero-cities-list",
        class: "w-full pl-10 pr-3 py-3.5 bg-surface-secondary border border-border/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary focus:bg-white transition-all text-sm font-semibold text-heading placeholder-muted shadow-inner" %>
    <datalist id="hero-cities-list">
      <% @cities.each do |city| %>
        <option value="<%= city %>"></option>
      <% end %>
    </datalist>
  </div>

  <%# 4. Botón de Búsqueda (2 Cols) %>
  <button type="submit" class="md:col-span-2 w-full py-3.5 px-5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm font-bold rounded-2xl hover:from-blue-500 hover:to-indigo-500 focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all active:scale-95 shadow-lg shadow-primary/20 hover:shadow-primary/30 flex items-center justify-center gap-2">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span>Buscar</span>
  </button>

<% end %>
