<%# Home Page - Landing %>
<% if @hero_events.any? %>
  <%# Contenedor del Hero Dinámico %>
  <div class="relative">
    <%# Carrusel %>
    <div data-controller="carousel" data-carousel-autoplay-interval-value="5000" class="relative w-full h-[450px] md:h-[550px] lg:h-[650px] overflow-hidden bg-slate-950">
      <% @hero_events.each_with_index do |event, index| %>
        <div data-carousel-target="slide" 
             class="absolute inset-0 w-full h-full transition-all duration-700 ease-in-out opacity-0 z-0"
             style="<%= index == 0 ? 'opacity: 1; z-index: 10;' : 'pointer-events: none;' %>">
          
          <%# Imagen de fondo %>
          <div class="absolute inset-0 w-full h-full">
            <% if event.primary_image.present? %>
              <%= image_tag event.primary_image.image_url, 
                            alt: event.name, 
                            class: "w-full h-full object-cover object-center", 
                            fetchpriority: (index == 0 ? "high" : "low"),
                            loading: (index == 0 ? "eager" : "lazy") %>
            <% end %>
            <%# Degradados overlay para asegurar legibilidad %>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-slate-900/20"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-transparent to-transparent"></div>
          </div>

          <%# Contenido de la diapositiva %>
          <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center">
            <div class="max-w-3xl text-white">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-primary/20 text-blue-300 border border-primary/30 backdrop-blur-md mb-4 uppercase tracking-wider">
                <%= event.category.name %>
              </span>
              <h2 class="text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-4 drop-shadow-sm">
                <%= event.name %>
              </h2>
              <p class="text-sm md:text-base text-gray-300 max-w-2xl mb-6 line-clamp-2 drop-shadow-sm">
                <%= event.description %>
              </p>
              
              <div class="flex flex-wrap items-center gap-4 text-xs md:text-sm text-gray-300 font-semibold mb-6">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <%= l(event.start_date, format: :long) %>
                </span>
                <span class="opacity-30">•</span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <%= event.city %>, <%= event.address %>
                </span>
              </div>

              <div class="flex items-center gap-3">
                <%= link_to new_event_booking_path(event), class: "inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-bold rounded-2xl transition-all shadow-lg shadow-primary/20 hover:shadow-primary/30 active:scale-95 gap-2" do %>
                  <span>Comprar Entradas</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                <% end %>
                <%= link_to "Ver detalles", event_path(event), class: "inline-flex items-center justify-center px-6 py-3 bg-white/10 hover:bg-white/20 text-white text-sm font-bold rounded-2xl transition-all backdrop-blur-sm active:scale-95" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%# Flechas de navegación (ocultas en mobile, visibles hover en desktop) %>
      <button data-action="click->carousel#prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-30 hidden md:flex items-center justify-center w-12 h-12 rounded-2xl bg-black/30 hover:bg-black/50 text-white backdrop-blur-sm border border-white/10 transition-all active:scale-90" aria-label="Anterior">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button data-action="click->carousel#next" class="absolute right-4 top-1/2 -translate-y-1/2 z-30 hidden md:flex items-center justify-center w-12 h-12 rounded-2xl bg-black/30 hover:bg-black/50 text-white backdrop-blur-sm border border-white/10 transition-all active:scale-90" aria-label="Siguiente">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <%# Dots indicadores %>
      <div class="absolute bottom-6 left-0 right-0 z-30 flex justify-center gap-2">
        <% @hero_events.each_with_index do |_, index| %>
          <button data-carousel-target="dot" 
                  data-action="click->carousel#jump" 
                  data-index="<%= index %>" 
                  class="w-2.5 h-2.5 rounded-full bg-white transition-all duration-300"
                  style="<%= index == 0 ? 'opacity: 1; transform: scale(1.25);' : 'opacity: 0.4; transform: scale(1);' %>"
                  aria-label="Ir a diapositiva <%= index + 1 %>"></button>
        <% end %>
      </div>
    </div>
  </div>

<% else %>
  <%# Fallback: Hero clásico sin imágenes %>
  <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white relative overflow-hidden">
    <%# Premium background blur blobs %>
    <div class="absolute top-[-20%] right-[-10%] w-[500px] h-[500px] rounded-full bg-primary/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[400px] h-[400px] rounded-full bg-indigo-500/10 blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 relative z-10">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-none tracking-tight">
          Descubre eventos <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-indigo-300">increíbles</span>
        </h1>
        <p class="mt-4 text-base md:text-lg text-muted max-w-2xl leading-relaxed">
          Explora conciertos, conferencias, talleres y más. Encuentra tu próximo evento favorito de la manera más fácil.
        </p>

        <div class="mt-8">
          <%= link_to "Explorar eventos", events_path, class: "inline-flex items-center justify-center px-6 py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-bold rounded-2xl transition-all shadow-lg shadow-primary/20 hover:shadow-primary/30 active:scale-95 gap-2" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# Upcoming Events Section %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="flex justify-between items-center mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-heading">Próximos eventos</h2>
  </div>

  <% if @upcoming_events.any? %>
    <div id="home_upcoming_events" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render partial: "events/event_card", collection: @upcoming_events, as: :event %>
    </div>
    
    <%= turbo_frame_tag "home_load_more_button" do %>
      <% if @upcoming_events.next_page %>
        <div class="mt-10 flex justify-center">
          <%= link_to "Ver más", root_path(page: @upcoming_events.next_page, format: :turbo_stream), class: "btn-secondary bg-surface border border-border text-heading px-6 py-2 rounded-full hover:bg-surface-secondary transition-colors font-medium", data: { turbo_stream: true } %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="text-center py-12 bg-white rounded-badge border border-border">
      <p class="text-body-tertiary">No hay eventos próximos disponibles.</p>
      <p class="text-muted text-sm mt-2">Vuelve pronto para descubrir nuevos eventos.</p>
    </div>
  <% end %>
</section>

<%# Categories Section %>
<section class="bg-white border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-8">Categorías</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <% navbar_categories.each do |category| %>
        <%= link_to events_path(category_id: category.id), class: "group p-6 bg-surface-secondary rounded-badge border border-border hover:border-primary hover:bg-primary/10 transition-all" do %>
          <h3 class="font-semibold text-heading group-hover:text-link-hover"><%= category.name %></h3>
          <% if category.description.present? %>
            <p class="text-sm text-body-tertiary mt-1 line-clamp-2"><%= category.description %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# Call to Action %>
<section class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-2xl md:text-3xl font-bold">¿Eres organizador?</h2>
    <p class="mt-4 text-muted max-w-2xl mx-auto">
      Crea y gestiona tus propios eventos. Llega a más personas con nuestra plataforma.
    </p>
    <div class="mt-8">
      <% if user_signed_in? && (current_user.admin? || current_user.organizer?) %>
        <%= link_to "Crear evento", new_organizer_event_path, class: "inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-card hover:bg-primary-hover transition-colors" %>
      <% elsif user_signed_in? %>
        <%= link_to "Explorar eventos", events_path, class: "inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-card hover:bg-primary-hover transition-colors" %>
      <% else %>
              <% unless user_signed_in? %>
                <%= link_to "Registrarse como organizador", new_user_registration_path(role: 'organizer'), class: "inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-card hover:bg-primary-hover transition-colors" %>
              <% end %>
            <% end %>
    </div>
  </div>
</section>