<%# Home Page - Landing %>
<div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white relative overflow-hidden">
  <%# Premium background blur blobs %>
  <div class="absolute top-[-20%] right-[-10%] w-[500px] h-[500px] rounded-full bg-blue-500/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[-20%] left-[-10%] w-[400px] h-[400px] rounded-full bg-indigo-500/10 blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 relative z-10">
    <div class="max-w-4xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-none tracking-tight">
        Descubrí eventos <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-indigo-300">increíbles</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-gray-300 max-w-2xl leading-relaxed">
        Explorá conciertos, conferencias, talleres y más. Encontrá tu próximo evento favorito de la manera más fácil.
      </p>

      <%# Premium Floating Search Bar Container %>
      <div class="bg-white/95 backdrop-blur-xl border border-white/10 shadow-2xl rounded-3xl p-4 md:p-5 mt-10 text-gray-800 transform transition-all duration-300 hover:shadow-blue-500/5">
        <%= form_tag events_path, method: :get, class: "grid grid-cols-1 md:grid-cols-12 gap-3" do %>
          
          <%# 1. Palabra Clave (4 Cols) %>
          <div class="relative md:col-span-4">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <%= text_field_tag :query, params[:query], 
                placeholder: "¿Qué querés hacer? (Ej: música)",
                class: "w-full pl-10 pr-3 py-3.5 bg-gray-50 border border-gray-200/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-semibold text-gray-900 placeholder-gray-400 shadow-inner" %>
          </div>

          <%# 2. Categoría Dropdown (3 Cols) %>
          <div class="relative md:col-span-3">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </span>
            <%= select_tag :category_id,
                options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
                prompt: "Todas las categorías",
                class: "w-full pl-10 pr-8 py-3.5 bg-gray-50 border border-gray-200/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-semibold text-gray-900 placeholder-gray-400 shadow-inner appearance-none cursor-pointer" %>
            <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-gray-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </div>

          <%# 3. Ciudad Input con Datalist Suggestions (3 Cols) %>
          <div class="relative md:col-span-3">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <%= text_field_tag :city, params[:city], 
                placeholder: "¿Dónde? (Ej: Lima)",
                list: "hero-cities-list",
                class: "w-full pl-10 pr-3 py-3.5 bg-gray-50 border border-gray-200/80 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all text-sm font-semibold text-gray-900 placeholder-gray-400 shadow-inner" %>
            <datalist id="hero-cities-list">
              <% @cities.each do |city| %>
                <option value="<%= city %>"></option>
              <% end %>
            </datalist>
          </div>

          <%# 4. Botón de Búsqueda (2 Cols) %>
          <button type="submit" class="md:col-span-2 w-full py-3.5 px-5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm font-bold rounded-2xl hover:from-blue-500 hover:to-indigo-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all active:scale-95 shadow-lg shadow-blue-600/20 hover:shadow-blue-600/30 flex items-center justify-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Buscar</span>
          </button>

        <% end %>
      </div>

      <%# Sugerencias rápidas %>
      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-400 font-semibold px-2">
        <span>Búsquedas populares:</span>
        <%= link_to "Conciertos", events_path(query: "concierto"), class: "text-blue-400 hover:text-blue-300 hover:underline transition-colors" %>
        <span class="opacity-30">•</span>
        <%= link_to "Tecnología", events_path(query: "tecnología"), class: "text-blue-400 hover:text-blue-300 hover:underline transition-colors" %>
        <% if @cities.any? %>
          <span class="opacity-30">•</span>
          <%= link_to @cities.first, events_path(city: @cities.first), class: "text-blue-400 hover:text-blue-300 hover:underline transition-colors" %>
        <% end %>
      </div>

    </div>
  </div>
</div>

<%# Upcoming Events Section %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="flex justify-between items-center mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900">Próximos eventos</h2>
    <%= link_to "Ver todos →", events_path, class: "text-blue-600 hover:text-blue-800 font-medium transition-colors" %>
  </div>

  <% if @upcoming_events.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render partial: "events/event_card", collection: @upcoming_events, as: :event %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
      <p class="text-gray-500">No hay eventos próximos disponibles.</p>
      <p class="text-gray-400 text-sm mt-2">Vuelve pronto para descubrir nuevos eventos.</p>
    </div>
  <% end %>
</section>

<%# Categories Section %>
<section class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Categorías</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <% @categories.each do |category| %>
        <%= link_to events_path(category_id: category.id), class: "group p-6 bg-gray-50 rounded-xl border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition-all" do %>
          <h3 class="font-semibold text-gray-900 group-hover:text-blue-700"><%= category.name %></h3>
          <% if category.description.present? %>
            <p class="text-sm text-gray-500 mt-1 line-clamp-2"><%= category.description %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# Call to Action %>
<section class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-2xl md:text-3xl font-bold">¿Eres organizador?</h2>
    <p class="mt-4 text-gray-300 max-w-2xl mx-auto">
      Crea y gestiona tus propios eventos. Llega a más personas con nuestra plataforma.
    </p>
    <div class="mt-8">
      <% if user_signed_in? && (current_user.admin? || current_user.organizer?) %>
        <%= link_to "Crear evento", new_organizer_event_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors" %>
      <% elsif user_signed_in? %>
        <%= link_to "Explorar eventos", events_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors" %>
      <% else %>
              <% unless user_signed_in? %>
                <%= link_to "Registrarse como organizador", new_user_registration_path(role: 'organizer'), class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors" %>
              <% end %>
            <% end %>
    </div>
  </div>
</section>