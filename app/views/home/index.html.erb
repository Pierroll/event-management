<%# Home Page - Landing %>
<div class="bg-gradient-to-br from-blue-600 to-blue-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
        Descubre los mejores eventos
      </h1>
      <p class="mt-6 text-lg md:text-xl text-blue-100 leading-relaxed">
        Explora conciertos, conferencias, talleres y más. Encuentra tu próximo evento favorito.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <%= link_to "Explorar eventos", events_path, class: "inline-flex items-center px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg hover:bg-blue-50 transition-colors shadow-lg" %>
        <% unless user_signed_in? %>
                  <%= link_to "Registrarse", new_user_registration_path, class: "inline-flex items-center px-6 py-3 border-2 border-white/30 text-white font-semibold rounded-lg hover:border-white/50 transition-colors" %>
                <% end %>
      </div>
    </div>
  </div>
</div>

<%# Upcoming Events Section %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="flex justify-between items-center mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900">Próximos eventos</h2>
    <%= link_to "Ver todos →", events_path, class: "text-blue-600 hover:text-blue-800 font-medium transition-colors" %>
  </div>

  <% if @upcoming_events.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render partial: "events/event_card", collection: @upcoming_events, as: :event %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
      <p class="text-gray-500">No hay eventos próximos disponibles.</p>
      <p class="text-gray-400 text-sm mt-2">Vuelve pronto para descubrir nuevos eventos.</p>
    </div>
  <% end %>
</section>

<%# Categories Section %>
<section class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Categorías</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <% @categories.each do |category| %>
        <%= link_to events_path(category_id: category.id), class: "group p-6 bg-gray-50 rounded-xl border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition-all" do %>
          <h3 class="font-semibold text-gray-900 group-hover:text-blue-700"><%= category.name %></h3>
          <% if category.description.present? %>
            <p class="text-sm text-gray-500 mt-1 line-clamp-2"><%= category.description %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<%# Call to Action %>
<section class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-2xl md:text-3xl font-bold">¿Eres organizador?</h2>
    <p class="mt-4 text-gray-300 max-w-2xl mx-auto">
      Crea y gestiona tus propios eventos. Llega a más personas con nuestra plataforma.
    </p>
    <div class="mt-8">
      <% if user_signed_in? && (current_user.admin? || current_user.organizer?) %>
        <%= link_to "Crear evento", new_organizer_event_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors" %>
      <% elsif user_signed_in? %>
        <%= link_to "Explorar eventos", events_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors" %>
      <% else %>
              <% unless user_signed_in? %>
                <%= link_to "Registrarse", new_user_registration_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors" %>
              <% end %>
            <% end %>
    </div>
  </div>
</section>