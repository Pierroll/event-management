<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SGE - Sistema de Gestión de Eventos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SGE">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag 'favicon.png', type: 'image/png' %>

    <link rel="apple-touch-icon" href="<%= asset_path 'apple-touch-icon.png' %>">

    <%# Fonts: Plus Jakarta Sans %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">

    <%# Stylesheet %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%# Leaflet CSS for maps %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <%# JavaScript %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-heading antialiased" data-controller="confirm">
    <%# Navigation %>
    <%= render "shared/navbar" %>

    <%# Custom Confirmation Modal %>
    <div data-confirm-target="modal" 
         class="hidden fixed inset-0 z-[200] items-center justify-center p-4 bg-gray-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-200 ease-out">
      <div class="modal-content scale-95 opacity-0 bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden transition-[transform,opacity] duration-300 ease-spring">
        <div class="p-8 text-center">
          <div class="icon-container w-20 h-20 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-6 transition-colors duration-300">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <h3 data-confirm-target="title" class="text-2xl font-bold text-heading mb-2">Confirmar</h3>
          <p data-confirm-target="message" class="text-body-tertiary font-medium">¿Estás seguro de que quieres realizar esta acción?</p>
        </div>
        <div class="flex border-t border-border-light">
          <button data-action="click->confirm#cancel" 
                  class="flex-1 px-6 py-4 text-sm font-bold text-muted hover:text-heading transition-colors border-r border-border-light">
            Cancelar
          </button>
          <button data-action="click->confirm#confirm" 
                  class="flex-1 px-6 py-4 text-sm font-bold text-error hover:bg-error/10 transition-colors">
            Confirmar
          </button>
        </div>
      </div>
    </div>

    <%# Flash Messages (High-End Toast System) %>
    <% if flash.any? %>
      <div class="fixed bottom-6 right-6 z-[100] flex flex-col gap-3 max-w-md w-full sm:w-[380px]">
        <% flash.each do |type, message| %>
          <% 
            config = case type.to_s
            when "notice", "success" 
              { border: "border-primary/20", shadow: "shadow-primary/10", accent: "bg-primary", 
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>' }
            when "alert", "error" 
              { border: "border-error/20", shadow: "shadow-error/10", accent: "bg-error/100",
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>' }
            when "warning" 
              { border: "border-warning/20", shadow: "shadow-warning/10", accent: "bg-warning",
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>' }
            else 
              { border: "border-primary/20", shadow: "shadow-primary/10", accent: "bg-primary/100",
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>' }
            end 
          %>
          <div data-controller="flash" 
               data-turbo-cache="false"
               class="group relative overflow-hidden bg-white/80 backdrop-blur-xl border <%= config[:border] %> rounded-2xl p-4 shadow-2xl <%= config[:shadow] %> flex items-center gap-4 transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] transform opacity-100 translate-y-0 hover:scale-[1.02]"
               role="alert">
            
            <%# Progress bar background %>
            <div class="absolute bottom-0 left-0 h-1 <%= config[:accent] %> opacity-20 w-full"></div>
            <%# Animated accent line %>
            <div class="absolute left-0 top-0 bottom-0 w-1.5 <%= config[:accent] %> rounded-r-full"></div>

            <div class="flex-shrink-0 w-10 h-10 rounded-badge <%= config[:accent] %> flex items-center justify-center text-white shadow-lg <%= config[:shadow] %>">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <%= config[:icon].html_safe %>
              </svg>
            </div>

            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold uppercase tracking-wider opacity-40 mb-0.5">Notificación</h4>
              <p class="text-[15px] font-semibold text-body leading-tight truncate-2-lines"><%= message %></p>
            </div>

            <button type="button" 
                    data-action="click->flash#close" 
                    class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-secondary text-muted hover:text-heading transition-all">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Main Content %>
    <main class="min-h-screen">
      <%= yield %>
    </main>

    <%# Footer %>
    <%= render "shared/footer" %>
  </body>
</html>
