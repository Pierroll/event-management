<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Actify - Sistema de Gestión de Eventos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Actify">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag '/icon2.png', rel: 'icon', type: 'image/png' %>

    <link rel="apple-touch-icon" href="/icon2.png">

    <%# Fonts: Plus Jakarta Sans %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">

    <%# Stylesheet %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%# Leaflet CSS and JS for maps %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <%# JavaScript %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="bg-background text-heading antialiased" data-controller="confirm">
    <%# Navigation %>
    <%= render "shared/navbar" %>

    <%# Custom Confirmation Modal %>
    <div data-confirm-target="modal" 
         class="hidden fixed inset-0 z-[200] items-center justify-center p-4 bg-gray-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-200 ease-out">
      <div class="modal-content scale-95 opacity-0 bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden transition-[transform,opacity] duration-300 ease-spring">
        <div class="p-8 text-center">
          <div class="icon-container w-20 h-20 bg-error/10 rounded-full flex items-center justify-center mx-auto mb-6 transition-colors duration-300">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <h3 data-confirm-target="title" class="text-2xl font-bold text-heading mb-2">Confirmar</h3>
          <p data-confirm-target="message" class="text-body-tertiary font-medium">¿Estás seguro de que quieres realizar esta acción?</p>
        </div>
        <div class="flex border-t border-border-light">
          <button data-action="click->confirm#cancel" 
                  class="flex-1 px-6 py-4 text-sm font-bold text-muted hover:text-heading transition-colors border-r border-border-light">
            Cancelar
          </button>
          <button data-action="click->confirm#confirm" 
                  class="flex-1 px-6 py-4 text-sm font-bold text-error hover:bg-error/10 transition-colors">
            Confirmar
          </button>
        </div>
      </div>
    </div>

    <%# Flash Messages (High-End Toast System) %>
    <div id="flash-container" class="fixed bottom-6 right-6 z-[100] flex flex-col gap-3 max-w-md w-full sm:w-[380px]">
      <% if flash.any? %>
        <% flash.each do |type, message| %>
          <%= render "shared/flash_message", type: type, message: message %>
        <% end %>
      <% end %>
    </div>

    <%# Main Content %>
    <main class="min-h-screen">
      <%= yield %>
    </main>

    <%# Footer %>
    <%= render "shared/footer" %>
  </body>
</html>
