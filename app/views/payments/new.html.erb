<% content_for :title, "Completar pago — #{@booking.event.name}" %>

<div class="max-w-lg mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-heading mb-6">Completar pago</h1>

  <%# Booking Summary %>
  <div class="bg-white rounded-2xl shadow-raised border border-border p-6 mb-6 space-y-3">
    <h2 class="text-lg font-semibold text-heading"><%= @booking.event.name %></h2>
    <div class="text-sm text-body-secondary space-y-1">
      <p><span class="font-medium">Tipo:</span> <%= @booking.ticket_type.name %></p>
      <p><span class="font-medium">Cantidad:</span> <%= @booking.quantity %></p>
      <p><span class="font-medium">Precio unitario:</span> <%= number_to_currency @booking.unit_price, unit: "S/ " %></p>
    </div>
    <div class="pt-3 border-t border-border-light flex justify-between items-center">
      <span class="font-semibold text-heading">Total</span>
      <span class="text-xl font-bold text-link">
        <%= number_to_currency @booking.total_price, unit: "S/ " %>
      </span>
    </div>
  </div>

  <%# Expiration Timer %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-4 mb-6 text-center"
       data-controller="checkout-timer"
       data-checkout-timer-expires-at-value="<%= @booking.expires_at.iso8601 %>">
    <p class="text-sm text-yellow-700 font-medium">
      Tiempo restante para completar el pago
    </p>
    <p class="text-2xl font-bold text-yellow-800 font-mono tabular-nums mt-1"
       data-checkout-timer-target="display">
      --:--
    </p>
  </div>

  <%# Payment Form %>
  <%= form_with url: booking_payments_path(@booking),
                method: :post,
                id: "payment-form",
                class: "space-y-4" do |f| %>
    <%= hidden_field_tag :culqi_token_id, nil, id: "culqi_token_id" %>
    <%= hidden_field_tag :culqi_order_id, nil, id: "culqi_order_id" %>

    <div class="bg-white rounded-2xl shadow-raised border border-border p-6">
      <div id="culqi-checkout" class="min-h-[200px] flex items-center justify-center">
        <button type="button" id="pay-button"
                class="w-full py-4 bg-primary text-white text-sm font-bold rounded-2xl hover:bg-primary-hover transition-all shadow-lg shadow-primary/20 active:scale-95">
          Pagar con Culqi
        </button>
      </div>
    </div>

    <p class="text-xs text-muted text-center">
      Tus datos están seguros. El pago se procesa de forma segura a través de Culqi.
    </p>
  <% end %>
</div>

<%# Culqi JS + integration %>
<%# ponytail: direct script tag for Culqi CDN, swap to importmap if Culqi provides an ES module %>
<script src="https://checkout.culqi.com/js/v4"></script>
<script>
  function initializeCulqi() {
    const payButton = document.getElementById('pay-button');
    if (!payButton) return;

    // Remove existing event listener if any (by replacing the node or keeping it simple)
    // To prevent duplicate listeners on turbo restores, we can use a flag or just clone and replace the button
    const newPayButton = payButton.cloneNode(true);
    payButton.parentNode.replaceChild(newPayButton, payButton);

    newPayButton.addEventListener('click', function(e) {
      e.preventDefault();
      
      Culqi.publicKey = '<%= ENV["CULQI_PUBLIC_KEY"] %>';
      
      const settings = {
        title: '<%= j @booking.event.name %>',
        currency: 'PEN',
        description: '<%= j @booking.ticket_type.name %> x<%= @booking.quantity %>',
        amount: <%= (@booking.total_price * 100).to_i %>
      };

      <% if @order_id.present? %>
        settings.order = '<%= @order_id %>';
      <% end %>

      Culqi.settings(settings);

      // Habilitar Tarjeta, Yape y Plin (billeteras móviles)
      Culqi.options({
        paymentMethods: {
          tarjeta: true,
          yape: true,
          billetera: true
        }
      });

      Culqi.open();
    });
  }

  // Bind to both standard load and Turbo load events
  document.addEventListener('turbo:load', initializeCulqi);
  if (document.readyState !== 'loading') {
    initializeCulqi();
  } else {
    document.addEventListener('DOMContentLoaded', initializeCulqi);
  }

  window.culqi = function() {
    if (Culqi.token) {
      const token = Culqi.token.id;
      document.getElementById('culqi_token_id').value = token;
      document.getElementById('payment-form').submit();
    } else if (Culqi.order) {
      const orderId = (Culqi.order && Culqi.order.id) || '<%= @order_id %>';
      document.getElementById('culqi_order_id').value = orderId;
      document.getElementById('payment-form').submit();
    } else {
      const error = Culqi.error;
      if (error) {
        alert('Error de pago: ' + error.user_message);
      }
    }
  };
</script>
