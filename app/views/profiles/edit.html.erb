<%# Profile Edit %>
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white rounded-badge border border-border p-6 md:p-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-heading">Editar perfil</h1>
      <%= link_to "Volver", profile_path, class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
    </div>

    <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-error/10 border border-error/30 rounded-card p-4">
          <h3 class="text-sm font-medium text-error">
            <%= pluralize(@user.errors.count, "error") %> impidieron guardar:
          </h3>
          <ul class="mt-2 list-disc list-inside text-sm text-error">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Nombre", class: "block text-sm font-medium text-body mb-1" %>
        <%= f.text_field :name, class: "w-full border border-border-input rounded-input px-4 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
      </div>

      <div>
        <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-body mb-1" %>
        <%= f.email_field :email, class: "w-full border border-border-input rounded-input px-4 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
      </div>

      <div class="flex gap-3">
        <%= f.submit "Guardar cambios", class: "px-6 py-2 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
        <%= link_to "Cancelar", profile_path, class: "px-6 py-2 border border-border-input text-body text-sm font-medium rounded-card hover:bg-surface-secondary transition-colors" %>
      </div>
    <% end %>
  </div>
</div>