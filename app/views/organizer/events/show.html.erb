<%# Organizer Event Detail %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <%= link_to "← Mis eventos", organizer_events_path, class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
    <div class="flex items-center gap-2">
      <% if @event.check_in_enabled? %>
        <%= link_to "Ir al Check-in", organizer_event_check_in_path(@event), class: "px-4 py-2 bg-success text-white text-sm font-medium rounded-card hover:bg-success/90 transition-colors" %>
        <%= button_to "Cerrar Check-in", organizer_event_path(@event), method: :patch, params: { event: { check_in_enabled: false } },
            class: "px-4 py-2 bg-amber-600 text-white text-sm font-medium rounded-card hover:bg-amber-700 transition-colors" %>
      <% else %>
        <%= button_to "Abrir Check-in", organizer_event_path(@event), method: :patch, params: { event: { check_in_enabled: true } },
            class: "px-4 py-2 bg-success/20 text-success border border-success/40 text-sm font-medium rounded-card hover:bg-success/30 transition-colors" %>
      <% end %>
      <%= link_to "Asistentes", attendees_organizer_event_path(@event), class: "px-4 py-2 bg-surface-secondary border border-border text-body text-sm font-medium rounded-card hover:bg-surface-tertiary transition-colors" %>
      <%= link_to "Editar", edit_organizer_event_path(@event), class: "px-4 py-2 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
      <%= button_to "Eliminar", organizer_event_path(@event), method: :delete,
          class: "px-4 py-2 bg-error text-white text-sm font-medium rounded-card hover:bg-error transition-colors",
          data: { turbo_confirm: "¿Eliminar este evento? Esta acción no se puede deshacer." } %>
    </div>
  </div>

  <div class="bg-white rounded-badge border border-border p-6 md:p-8">
    <% if @event.check_in_enabled? && @event.finished_more_than_48_hours_ago? %>
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-badge mb-6 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-yellow-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span class="text-sm font-medium">Este evento ya finalizó hace más de 48 horas. ¿Seguro que querés mantener el check-in activo?</span>
        </div>
        <%= button_to "Desactivar", organizer_event_path(@event), method: :patch, params: { event: { check_in_enabled: false } },
            class: "px-3 py-1 bg-yellow-600 hover:bg-yellow-700 text-white text-xs font-bold rounded-card transition-colors shrink-0" %>
      </div>
    <% end %>

    <%# Title and Status %>
    <div class="flex items-start justify-between gap-4">
      <h1 class="text-2xl md:text-3xl font-bold text-heading"><%= @event.name %></h1>
      <%= event_status_badge(@event, classes: "shrink-0 px-3 py-1 text-sm font-medium") %>
    </div>

    <%# Details Grid %>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <p class="text-sm text-body-tertiary">Categoría</p>
          <p class="font-medium text-heading"><%= @event.category&.name || "—" %></p>
        </div>
        <div>
          <p class="text-sm text-body-tertiary">Fecha de inicio</p>
          <p class="font-medium text-heading"><%= l(@event.start_date, format: :long) if @event.start_date %></p>
        </div>
        <% if @event.end_date %>
          <div>
            <p class="text-sm text-body-tertiary">Fecha de fin</p>
            <p class="font-medium text-heading"><%= l(@event.end_date, format: :long) %></p>
          </div>
        <% end %>
        <div>
          <p class="text-sm text-body-tertiary">Ciudad</p>
          <p class="font-medium text-heading"><%= @event.city %></p>
        </div>
      </div>
      <div class="space-y-4">
        <div>
          <p class="text-sm text-body-tertiary">Dirección</p>
          <p class="font-medium text-heading"><%= @event.address %></p>
        </div>
        <div>
          <p class="text-sm text-body-tertiary">Tipos de entrada</p>
          <div class="space-y-1 mt-1">
            <% @event.ticket_types.ordered.each do |tt| %>
              <p class="text-sm <%= tt.price > 0 ? "text-heading" : "text-success" %>">
                <%= tt.name %>: <%= tt.price > 0 ? number_to_currency(tt.price, unit: "S/ ") : "Gratis" %>
                <span class="text-muted">(<%= tt.remaining_capacity %> disp.)</span>
              </p>
            <% end %>
            <% if @event.ticket_types.empty? %>
              <p class="text-sm text-muted">Sin tipos de entrada</p>
            <% end %>
          </div>
        </div>
        <% if @event.max_capacity %>
          <div>
            <p class="text-sm text-body-tertiary">Capacidad máxima</p>
            <p class="font-medium text-heading"><%= @event.max_capacity %> personas</p>
          </div>
        <% end %>
        <div>
          <p class="text-sm text-body-tertiary">Valoración promedio</p>
          <p class="font-medium text-heading"><%= @event.average_rating > 0 ? "#{@event.average_rating} ★" : "Sin valoraciones" %></p>
        </div>
      </div>
    </div>

    <%# Description %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-heading mb-3">Descripción</h2>
      <div class="prose prose-gray max-w-none">
        <%= simple_format @event.description %>
      </div>
    </div>

    <%# Images %>
    <% if @event.event_images.any? %>
      <div class="mt-8">
        <h2 class="text-lg font-semibold text-heading mb-3">Imágenes</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <% @event.event_images.each do |img| %>
            <div class="aspect-video rounded-card overflow-hidden border border-border">
              <%= image_tag img.image_url, class: "w-full h-full object-cover" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>