<%# Organizer Dashboard - Events List %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-heading">Mis eventos</h1>
      <p class="mt-1 text-body-tertiary">Gestiona tus eventos creados</p>
    </div>
    <%= link_to new_organizer_event_path, class: "inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" do %>
      <span class="mr-1.5">+</span> Nuevo evento
    <% end %>
  </div>

  <%# Events Table %>
  <div class="bg-white rounded-badge border border-border overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-surface-secondary border-b border-border">
            <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Evento</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Categoría</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Fecha</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Estado</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Precio</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% if @events.any? %>
            <% @events.each do |event| %>
              <tr class="hover:bg-surface-secondary transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-surface-secondary rounded-card overflow-hidden shrink-0">
                      <% if event.event_images.any? %>
                        <%= image_tag event.event_images.first.image_url, class: "w-full h-full object-cover" %>
                      <% else %>
                        <div class="w-full h-full flex items-center justify-center text-muted">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                          </svg>
                        </div>
                      <% end %>
                    </div>
                    <div>
                      <%= link_to event.name, organizer_event_path(event), class: "text-sm font-medium text-heading hover:text-link transition-colors" %>
                      <p class="text-xs text-body-tertiary"><%= event.city %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-body-secondary"><%= event.category&.name || "—" %></td>
                <td class="px-6 py-4 text-sm text-body-secondary"><%= l(event.start_date, format: :short) if event.start_date %></td>
                <td class="px-6 py-4">
                  <%= event_status_badge(event, classes: "inline-flex items-center px-2.5 py-0.5 text-xs font-medium") %>
                </td>
                <td class="px-6 py-4 text-sm">
                  <% price_range = event.price_range %>
                  <% min_price = price_range.is_a?(Range) ? price_range.first : price_range %>
                  <% if min_price %>
                    <span class="font-medium <%= min_price > 0 ? "text-heading" : "text-success" %>">
                      <%= min_price > 0 ? number_to_currency(min_price, unit: "S/") : "Gratis" %>
                    </span>
                    <% if price_range.is_a?(Range) %>
                      <span class="text-muted">+</span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <% if event.draft? %>
                      <%= form_with scope: :event, url: organizer_event_path(event), method: :patch, class: "inline-block" do |f| %>
                        <%= f.hidden_field :status, value: "published" %>
                        <button type="submit" 
                                data-turbo-confirm="¿Estás seguro de que deseas publicar este evento? Será visible para todos los usuarios."
                                data-turbo-confirm-title="Publicar evento"
                                class="px-3 py-1.5 text-xs font-bold bg-success/10 text-success rounded-card hover:bg-success/20 transition-colors border border-success/30">
                          Publicar
                        </button>
                      <% end %>
                    <% end %>
                    <% if event.published? %>
                      <%= form_with scope: :event, url: organizer_event_path(event), method: :patch, class: "inline-block" do |f| %>
                        <%= f.hidden_field :status, value: "canceled" %>
                        <button type="submit" 
                                data-turbo-confirm="¿Estás seguro de que deseas cancelar este evento? Esta acción no se puede deshacer."
                                data-turbo-confirm-title="Cancelar evento"
                                class="px-3 py-1.5 text-xs font-bold bg-error/10 text-error rounded-card hover:bg-error/15 transition-colors border border-error/30">
                          Cancelar
                        </button>
                      <% end %>
                    <% end %>
                    <%= link_to "Ver", organizer_event_path(event),
                        class: "px-3 py-1.5 text-xs font-bold bg-white border border-border text-body rounded-card hover:bg-surface-secondary transition-colors" %>
                    <%= link_to "Editar", edit_organizer_event_path(event),
                        class: "px-3 py-1.5 text-xs font-bold bg-primary/10 text-link-hover rounded-card hover:bg-primary/20 transition-colors border border-primary/30" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-16 text-center">
                <div class="w-20 h-20 bg-surface-secondary text-muted rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-heading">No tienes eventos creados</h3>
                <p class="mt-2 text-body-tertiary max-w-xs mx-auto text-sm">Empieza a organizar tus propios eventos y llega a cientos de personas.</p>
                <%= link_to new_organizer_event_path,
                    class: "mt-8 inline-flex items-center px-6 py-3 bg-primary text-white text-sm font-bold rounded-badge hover:bg-primary-hover transition-all shadow-lg shadow-primary/20 active:scale-95" do %>
                  <span class="mr-2">+</span> Crear mi primer evento
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# Pagination %>
  <% if @events.total_pages > 1 %>
    <div class="mt-6">
      <%= paginate @events %>
    </div>
  <% end %>
</div>