<%# Organizer Dashboard - Events List %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="organizer-dashboard">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Mis eventos</h1>
      <p class="mt-1 text-gray-500">Gestiona tus eventos creados</p>
    </div>
    <%= link_to new_organizer_event_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" do %>
      <span class="mr-1.5">+</span> Nuevo evento
    <% end %>
  </div>

  <%# Events Table %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Evento</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Categoría</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
            <th class="text-left px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Precio</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200" data-organizer-dashboard-target="eventRow">
          <% if @events.any? %>
            <% @events.each do |event| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gray-100 rounded-lg overflow-hidden shrink-0">
                      <% if event.event_images.any? %>
                        <%= image_tag event.event_images.first.image_url, class: "w-full h-full object-cover" %>
                      <% else %>
                        <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs">📷</div>
                      <% end %>
                    </div>
                    <div>
                      <%= link_to event.name, organizer_event_path(event), class: "text-sm font-medium text-gray-900 hover:text-blue-600 transition-colors" %>
                      <p class="text-xs text-gray-500"><%= event.city %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600"><%= event.category&.name || "—" %></td>
                <td class="px-6 py-4 text-sm text-gray-600"><%= l(event.start_date, format: :short) if event.start_date %></td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <%= event.published? ? "bg-green-100 text-green-800" : "" %>
                    <%= event.draft? ? "bg-yellow-100 text-yellow-800" : "" %>
                    <%= event.canceled? ? "bg-red-100 text-red-800" : "" %>
                    <%= event.finished? ? "bg-gray-100 text-gray-800" : "" %>">
                    <%= event.status.humanize %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm font-medium">
                  <%= event.price > 0 ? number_to_currency(event.price, unit: "S/") : "Gratis" %>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <% if event.draft? %>
                      <%= form_with url: organizer_event_path(event), method: :patch, local: false,
                          data: { event_id: event.id, action: "organizer-dashboard#publish", event_id_param: event.id } do |f| %>
                        <%= f.hidden_field :status, value: "published" %>
                        <button type="submit" class="px-3 py-1.5 text-xs font-medium bg-green-100 text-green-700 rounded-lg hover:bg-green-200 transition-colors">
                          Publicar
                        </button>
                      <% end %>
                    <% end %>
                    <% if event.published? %>
                      <%= form_with url: organizer_event_path(event), method: :patch, local: false,
                          data: { event_id: event.id, action: "organizer-dashboard#cancel", event_id_param: event.id } do |f| %>
                        <%= f.hidden_field :status, value: "canceled" %>
                        <button type="submit" class="px-3 py-1.5 text-xs font-medium bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors">
                          Cancelar
                        </button>
                      <% end %>
                    <% end %>
                    <%= link_to "Editar", edit_organizer_event_path(event),
                        class: "px-3 py-1.5 text-xs font-medium bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center">
                <div class="text-4xl mb-4">📋</div>
                <h3 class="text-lg font-semibold text-gray-900">No tienes eventos creados</h3>
                <p class="mt-2 text-gray-500">Crea tu primer evento para empezar.</p>
                <%= link_to "Crear evento", new_organizer_event_path,
                    class: "mt-4 inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# Pagination %>
  <% if @events.total_pages > 1 %>
    <div class="mt-6">
      <%= paginate @events %>
    </div>
  <% end %>
</div>