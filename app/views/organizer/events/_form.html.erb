<%# Organizer Event Form Partial %>
<%= form_with model: [:organizer, event], local: true, html: { multipart: true },
    data: { controller: "event-form", action: "submit->event-form#validate" }, class: "space-y-6" do |f| %>
  <%# Validation Errors Container %>
  <div data-event-form-target="errorContainer"></div>

  <%# Rails Validation Errors %>
  <% if event.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-sm font-medium text-red-800">
        <%= pluralize(event.errors.count, "error") %> impidieron guardar:
      </h3>
      <ul class="mt-2 list-disc list-inside text-sm text-red-600">
        <% event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Name %>
    <div class="md:col-span-2">
      <%= f.label :name, "Nombre del evento", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, id: "event_name",
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "Ej: Conferencia de Tecnología 2025" %>
    </div>

    <%# Description %>
    <div class="md:col-span-2">
      <%= f.label :description, "Descripción", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 5, id: "event_description",
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "Describe los detalles del evento..." %>
    </div>

    <%# Category %>
    <div>
      <%= f.label :category_id, "Categoría", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :category_id, Category.active, :id, :name,
          { prompt: "Seleccionar categoría" }, id: "event_category_id",
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <%# Status %>
    <div>
      <%= f.label :status, "Estado", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :status, Event.statuses.keys.map { |s| [s.humanize, s] },
          {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <%# City %>
    <div>
      <%= f.label :city, "Ciudad", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :city, id: "event_city",
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "Ej: Lima" %>
    </div>

    <%# Address %>
    <div>
      <%= f.label :address, "Dirección", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :address, id: "event_address",
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "Ej: Av. Principal 123" %>
    </div>

    <%# Start Date %>
    <div>
      <%= f.label :start_date, "Fecha de inicio", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_field :start_date, id: "event_start_date",
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <%# End Date %>
    <div>
      <%= f.label :end_date, "Fecha de fin (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_field :end_date,
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <%# Price %>
    <div>
      <%= f.label :price, "Precio", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500 text-sm">S/</span>
        <%= f.number_field :price, id: "event_price", step: 0.01, min: 0,
            class: "w-full pl-8 border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
            placeholder: "0.00" %>
      </div>
    </div>

    <%# Currency %>
    <div>
      <%= f.label :currency, "Moneda", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :currency, [["PEN (Soles)", "PEN"], ["USD (Dólares)", "USD"]],
          {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <%# Max Capacity %>
    <div>
      <%= f.label :max_capacity, "Capacidad máxima (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :max_capacity, min: 1,
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "Ej: 500" %>
    </div>

    <%# Latitude/Longitude (hidden, optional) %>
    <div>
      <%= f.label :latitude, "Latitud (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :latitude, step: 0.00000001,
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "-12.046374" %>
    </div>
    <div>
      <%= f.label :longitude, "Longitud (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :longitude, step: 0.00000001,
          class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "-77.042793" %>
    </div>
  </div>

  <%# Image Upload Section - Premium Experience %>
  <div class="md:col-span-2 space-y-4" data-controller="event-form">
    <label class="block text-sm font-bold text-gray-700 uppercase tracking-wider opacity-60">Galería del evento</label>
    
    <div class="bg-gray-50/50 border border-gray-200 rounded-2xl p-6">
      <%# Tabs %>
      <div class="flex gap-4 mb-6 border-b border-gray-200 pb-4">
        <button type="button" 
                class="text-sm font-bold text-blue-600 border-b-2 border-blue-600 pb-4 -mb-4.5"
                data-action="click->event-form#showTab" 
                data-tab="file">
          Subir archivos
        </button>
        <button type="button" 
                class="text-sm font-bold text-gray-400 hover:text-gray-600 transition-colors"
                data-action="click->event-form#showTab" 
                data-tab="url">
          Desde URL
        </button>
      </div>

      <%# File Upload Pane %>
      <div data-event-form-target="filePane">
        <div data-event-form-target="dropzone"
             data-action="dragover->event-form#dragOver dragleave->event-form#dragLeave drop->event-form#drop click->event-form#browse"
             class="group relative border-2 border-dashed border-gray-300 rounded-2xl p-10 text-center hover:border-blue-400 hover:bg-white transition-all cursor-pointer bg-white/50 backdrop-blur-sm">
          
          <div class="w-16 h-16 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>

          <h3 class="text-gray-900 font-bold mb-1">Arrastra tus fotos aquí</h3>
          <p class="text-sm text-gray-500">O haz clic para explorar tus archivos</p>
          <p class="text-[10px] text-gray-400 mt-4 uppercase tracking-widest font-bold">Máximo 5MB por imagen • JPG, PNG, WEBP</p>
          
          <%= f.file_field :images, multiple: true, accept: "image/*", 
              data: { event_form_target: "fileInput", action: "change->event-form#fileChange" },
              class: "hidden" %>
        </div>
      </div>

      <%# URL Upload Pane %>
      <div data-event-form-target="urlPane" class="hidden animate-in fade-in slide-in-from-bottom-2 duration-300">
        <div class="bg-white rounded-2xl p-4 border border-gray-200 shadow-sm">
          <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Enlace de la imagen</label>
          <div class="flex gap-2">
            <input type="url" 
                   data-event-form-target="urlInput"
                   placeholder="https://ejemplo.com/imagen.jpg"
                   class="flex-1 bg-gray-50 border-none rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500">
            <button type="button" 
                    data-action="click->event-form#addFromUrl"
                    class="bg-blue-600 text-white px-6 py-2 rounded-xl text-sm font-bold hover:bg-blue-700 transition-colors">
              Agregar
            </button>
          </div>
        </div>
      </div>

      <%# Global Preview Container %>
      <div data-event-form-target="previewContainer" class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <%# Las imágenes se renderizan aquí dinámicamente %>
      </div>
    </div>
  </div>

  <%# Submit Button %>
  <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
    <%= f.submit event.new_record? ? "Crear evento" : "Guardar cambios",
        class: "px-6 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
    <%= link_to "Cancelar", organizer_events_path,
        class: "px-6 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
  </div>
<% end %>