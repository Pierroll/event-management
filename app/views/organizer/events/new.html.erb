<%# New Event Form %>
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-heading">Crear nuevo evento</h1>
    <%= link_to "← Volver", organizer_events_path, class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
  </div>

  <div class="bg-white rounded-badge border border-border p-6 md:p-8">
    <%= render "form", event: @event %>
  </div>
</div>