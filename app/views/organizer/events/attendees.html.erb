<% content_for :title, "Asistentes — #{@event.name}" %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
    <div>
      <%= link_to "← Volver al evento", organizer_event_path(@event), class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
      <h1 class="text-3xl font-black tracking-tight text-heading mt-2"><%= @event.name %></h1>
      <p class="text-sm text-body-tertiary mt-1">Panel de trazabilidad y reporte de asistencia de clientes.</p>
    </div>
    
    <% if @event.check_in_enabled? %>
      <%= link_to "Ir al Check-in", organizer_event_check_in_path(@event), class: "px-5 py-2.5 bg-success text-white text-sm font-semibold rounded-badge hover:bg-success/90 transition-all flex items-center gap-2 self-start md:self-center shadow-raised" %>
    <% end %>
  </div>

  <%# ─── KPI Cards ──────────────────────────────────────────────────────── %>
  <%
    total_tickets = @tickets.count
    valid_tickets = @tickets.where(status: [:active, :used]).count
    used_tickets = @tickets.used.count
    attendance_rate = valid_tickets > 0 ? (used_tickets.to_f / valid_tickets * 100).round(1) : 0
  %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-badge border border-border p-6 shadow-raised">
      <span class="text-[10px] font-black uppercase tracking-widest text-muted block mb-1">Entradas vendidas</span>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-black text-heading"><%= total_tickets %></span>
        <span class="text-xs text-muted">tickets</span>
      </div>
      <p class="text-[11px] text-body-tertiary mt-2">Total de tickets emitidos para el evento.</p>
    </div>

    <div class="bg-white rounded-badge border border-border p-6 shadow-raised">
      <span class="text-[10px] font-black uppercase tracking-widest text-muted block mb-1">Ingresos registrados</span>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-black text-success"><%= used_tickets %></span>
        <span class="text-xs text-muted">/ <%= valid_tickets %> activos</span>
      </div>
      <p class="text-[11px] text-body-tertiary mt-2">Asistentes que ya pasaron por puerta.</p>
    </div>

    <div class="bg-white rounded-badge border border-border p-6 shadow-raised">
      <span class="text-[10px] font-black uppercase tracking-widest text-muted block mb-1">Tasa de asistencia</span>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-black text-primary"><%= attendance_rate %>%</span>
      </div>
      <p class="text-[11px] text-body-tertiary mt-2">Porcentaje de tickets activos que ingresaron.</p>
    </div>
  </div>

  <%# ─── Tabla de Asistentes ─────────────────────────────────────────────── %>
  <div class="bg-white rounded-badge border border-border overflow-hidden shadow-raised">
    <div class="px-6 py-4 border-b border-border-light bg-surface-secondary flex items-center justify-between">
      <h2 class="text-sm font-black uppercase tracking-wider text-heading">Listado de Asistentes</h2>
      <span class="text-xs text-muted font-bold"><%= @tickets.size %> registros</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-border text-[10px] font-black uppercase tracking-wider text-body-tertiary bg-surface-secondary/50">
            <th class="px-6 py-3.5">Asistente / Portador</th>
            <th class="px-6 py-3.5">Comprador</th>
            <th class="px-6 py-3.5">Ticket</th>
            <th class="px-6 py-3.5">Fecha de Compra</th>
            <th class="px-6 py-3.5">Estado / Ingreso</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-light">
          <% @tickets.each do |ticket| %>
            <% buyer = ticket.booking.user %>
            <% attendee_name = ticket.attendee_name.presence || buyer.name %>
            <% attendee_email = ticket.attendee_email.presence || buyer.email %>
            <% is_different_buyer = buyer.name != attendee_name %>

            <tr class="hover:bg-surface-secondary/40 transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-primary/10 text-primary font-bold rounded-full flex items-center justify-center text-xs shrink-0">
                    <%= attendee_name[0].upcase %>
                  </div>
                  <div>
                    <p class="text-sm font-bold text-heading leading-tight"><%= attendee_name %></p>
                    <p class="text-xs text-body-tertiary"><%= attendee_email %></p>
                  </div>
                </div>
              </td>
              
              <td class="px-6 py-4">
                <% if is_different_buyer %>
                  <div>
                    <p class="text-xs font-semibold text-heading"><%= buyer.name %></p>
                    <p class="text-[10px] text-body-tertiary">Comprador</p>
                  </div>
                <% else %>
                  <span class="text-xs text-muted italic">Mismo asistente</span>
                <% end %>
              </td>

              <td class="px-6 py-4">
                <div>
                  <p class="text-xs font-bold text-heading"><%= ticket.booking.ticket_type.name %></p>
                  <p class="text-xs text-link font-semibold">
                    <%= ticket.booking.unit_price > 0 ? number_to_currency(ticket.booking.unit_price, unit: "S/ ") : "Gratis" %>
                  </p>
                </div>
              </td>

              <td class="px-6 py-4">
                <p class="text-xs text-heading"><%= l(ticket.created_at.to_date, format: :long) %></p>
                <p class="text-[10px] text-muted font-mono"><%= l(ticket.created_at, format: "%H:%M") %></p>
              </td>

              <td class="px-6 py-4">
                <% if ticket.used? %>
                  <div class="flex flex-col items-start gap-1">
                    <span class="bg-success/10 text-success text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full">
                      Ingresado
                    </span>
                    <% if ticket.checked_in_at %>
                      <span class="text-[9px] text-muted font-mono">
                        <%= l(ticket.checked_in_at, format: "%d/%m %H:%M") %>
                      </span>
                    <% end %>
                  </div>
                <% elsif ticket.active? %>
                  <span class="bg-blue-50 text-link text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border border-blue-100">
                    Pendiente
                  </span>
                <% else %>
                  <span class="bg-surface-tertiary text-body-tertiary text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full">
                    Cancelado
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @tickets.empty? %>
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-sm text-muted italic bg-surface-secondary/10">
                Aún no se han vendido entradas para este evento.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
