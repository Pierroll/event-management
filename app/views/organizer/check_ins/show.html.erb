<% content_for :title, "Check-in — #{@event.name}" %>

<div class="max-w-lg mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-heading mb-2">Check-in</h1>
  <p class="text-body-tertiary mb-6">Escané o ingresá el código QR de la entrada para registrar el ingreso.</p>

  <%# ─── Cámara (principal) ────────────────────────────────────────────── %>
  <div class="bg-white rounded-2xl shadow-raised border border-border p-4 mb-6">
    <div id="qr-reader" class="w-full aspect-square bg-surface-secondary rounded-badge overflow-hidden flex items-center justify-center text-muted text-sm">
      Inicializando cámara…
    </div>
    <p class="text-xs text-muted text-center mt-2">Posicioná el código QR frente a la cámara</p>
  </div>

  <%# ─── Input manual (fallback) ───────────────────────────────────────── %>
  <div class="bg-white rounded-2xl shadow-raised border border-border p-4 mb-6">
    <label for="manual_qr" class="block text-sm font-medium text-body mb-2">
      O ingresá el código manualmente
    </label>
    <div class="flex gap-2">
      <input type="text" id="manual_qr"
             placeholder="Código QR"
             class="flex-1 px-4 py-2.5 border border-border-input rounded-badge text-sm focus:ring-2 focus:ring-primary focus:border-primary outline-none">
      <button type="button" id="manual-checkin-btn"
              class="px-5 py-2.5 bg-primary text-white text-sm font-semibold rounded-badge hover:bg-primary-hover transition-colors">
        Verificar
      </button>
    </div>
  </div>

  <%# ─── Resultado ─────────────────────────────────────────────────────── %>
  <div id="checkin-result" class="hidden"></div>
</div>

<%# ponytail: html5-qrcode vía CDN, mismo approach que Culqi JS en payments/new %>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
  (function() {
    const resultDiv = document.getElementById('checkin-result');
    const manualInput = document.getElementById('manual_qr');
    const manualBtn = document.getElementById('manual-checkin-btn');

    function showResult(payload) {
      resultDiv.classList.remove('hidden');
      if (payload.success) {
        resultDiv.className = 'bg-success/5 border border-success/30 rounded-2xl p-4 text-center';
        resultDiv.innerHTML = '<p class="text-success font-semibold text-lg">✅ Ingreso registrado</p>' +
          (payload.attendee_name ? '<p class="text-success text-sm mt-1">' + payload.attendee_name + '</p>' : '');
      } else {
        resultDiv.className = 'bg-error/10 border border-error/30 rounded-2xl p-4 text-center';
        resultDiv.innerHTML = '<p class="text-error font-semibold">❌ ' + (payload.error || 'Error') + '</p>';
      }
      // Auto-hide after 5 seconds
      setTimeout(function() { resultDiv.classList.add('hidden'); }, 5000);
    }

    function processQR(code) {
      fetch('<%= organizer_event_check_in_path(@event) %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= form_authenticity_token %>' },
        body: JSON.stringify({ qr_code: code })
      })
      .then(function(r) { return r.json(); })
      .then(showResult)
      .catch(function(err) { showResult({ error: 'Error de conexión' }); });
    }

    // ── Camera scanner ──
    if (typeof Html5Qrcode !== 'undefined') {
      var scanner = new Html5Qrcode('qr-reader');
      Html5Qrcode.getCameras().then(function(cameras) {
        if (cameras && cameras.length) {
          scanner.start(
            { facingMode: 'environment' },
            { fps: 10, qrbox: { width: 250, height: 250 } },
            function(decodedText) {
              scanner.stop().catch(function(){});
              processQR(decodedText);
            },
            function() { /* no-op — scanning in progress */ }
          ).catch(function(err) {
            document.getElementById('qr-reader').innerHTML = '<p class="text-error text-sm">No se pudo acceder a la cámara. Usá el ingreso manual.</p>';
          });
        } else {
          document.getElementById('qr-reader').innerHTML = '<p class="text-muted text-sm">No se detectó cámara. Usá el ingreso manual.</p>';
        }
      }).catch(function() {
        document.getElementById('qr-reader').innerHTML = '<p class="text-muted text-sm">Permiso de cámara denegado. Usá el ingreso manual.</p>';
      });
    }

    // ── Manual input ──
    function manualCheckin() {
      var code = manualInput.value.trim();
      if (!code) return;
      processQR(code);
      manualInput.value = '';
    }

    manualBtn.addEventListener('click', manualCheckin);
    manualInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') manualCheckin();
    });
  })();
</script>
