<%# Footer - High-End Role-Aware Footer %>
<footer class="bg-white border-t border-gray-100 mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <%# Brand Section %>
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl font-black tracking-tighter text-gray-900">SGE</span>
          <div class="h-4 w-px bg-gray-200"></div>
          <span class="text-xs font-bold uppercase tracking-widest text-gray-400">Eventos</span>
        </div>
        <p class="text-gray-500 text-sm max-w-xs leading-relaxed">
          La plataforma líder para la gestión y descubrimiento de los eventos más importantes de la región. Conecta, organiza y vive experiencias únicas.
        </p>
      </div>

      <%# Navigation Sections %>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-gray-900 mb-6">Plataforma</h4>
        <ul class="space-y-4">
          <li><%= link_to "Inicio", root_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
          <li><%= link_to "Explorar eventos", events_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
          <% if user_signed_in? %>
            <li><%= link_to "Mi Perfil", profile_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
          <% end %>
        </ul>
      </div>

      <%# Role-Specific Links %>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-gray-900 mb-6">Gestionar</h4>
        <ul class="space-y-4">
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <li><%= link_to "Dashboard Admin", admin_dashboard_path, class: "text-sm text-purple-600 font-semibold hover:text-purple-800 transition-colors" %></li>
              <li><%= link_to "Usuarios", admin_users_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
              <li><%= link_to "Categorías", admin_categories_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
            <% elsif current_user.organizer? %>
              <li><%= link_to "Mis Eventos", organizer_events_path, class: "text-sm text-blue-600 font-semibold hover:text-blue-800 transition-colors" %></li>
              <li><%= link_to "Crear Evento", new_organizer_event_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
            <% else %>
              <li><%= link_to "Mis Comentarios", "#", class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
              <li><%= link_to "Eventos Guardados", "#", class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
            <% end %>
          <% else %>
            <li><%= link_to "Iniciar Sesión", new_user_session_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
            <li><%= link_to "Crear Cuenta", new_user_registration_path, class: "text-sm text-gray-500 hover:text-blue-600 transition-colors" %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <%# Bottom Bar %>
    <div class="mt-16 pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs font-medium text-gray-400">
        &copy; <%= Time.current.year %> SGE. Diseñado para la excelencia en gestión.
      </p>
      <div class="flex gap-6">
        <span class="text-[10px] font-black uppercase tracking-widest text-gray-300">v1.0.0 MVP</span>
      </div>
    </div>
  </div>
</footer>