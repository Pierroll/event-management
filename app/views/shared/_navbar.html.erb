<%# Main Navigation Bar %>
<nav class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <%# Logo %>
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="text-xl font-bold text-gray-900">SGE</span>
          <span class="text-sm text-gray-500 hidden sm:inline">Gestión de Eventos</span>
        <% end %>
      </div>

      <%# Navigation Links %>
      <div class="hidden md:flex items-center gap-6">
        <% if user_signed_in? && current_user.admin? %>
          <%# Admin Navigation %>
          <%= link_to "Usuarios", admin_users_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= link_to "Eventos", admin_events_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= link_to "Categorías", admin_categories_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= link_to "Admin", admin_dashboard_path, class: "text-sm font-medium text-purple-600 hover:text-purple-800 transition-colors font-semibold" %>
        <% elsif user_signed_in? && current_user.organizer? %>
          <%# Organizer Navigation %>
          <%= link_to "Explorar", events_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
          <%= link_to "Mis Eventos", organizer_events_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
        <% else %>
          <%# Public / Registered User Navigation %>
          <%= link_to "Explorar", events_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
        <% end %>

        <% if user_signed_in? %>
          <div class="flex items-center gap-3 ml-4 pl-4 border-l border-gray-200">
            <%= link_to profile_path, class: "text-sm font-medium text-gray-700 hover:text-gray-900" do %>
              <span><%= current_user.name %></span>
            <% end %>
            <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete,
                class: "text-sm text-gray-500 hover:text-red-600 transition-colors",
                data: { 
                  turbo_confirm: "¿Estás seguro de que deseas cerrar tu sesión actual?",
                  turbo_confirm_title: "Cerrar sesión"
                } %>
          </div>
        <% else %>
          <div class="flex items-center gap-3 ml-4 pl-4 border-l border-gray-200">
            <%= link_to "Iniciar sesión", new_user_session_path, class: "text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors" %>
            <%= link_to "Registrarse", new_user_registration_path,
                class: "text-sm font-medium bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
          </div>
        <% end %>
      </div>

      <%# Mobile menu button %>
      <div class="md:hidden">
        <button data-action="click->navbar#toggle" class="p-2 text-gray-600 hover:text-gray-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>