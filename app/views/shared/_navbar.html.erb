<%# Main Navigation Bar %>
<nav class="bg-white border-b border-border-light sticky top-0 z-40" data-controller="navbar" data-action="keydown.esc->navbar#closeOnEsc">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <%# Logo %>
      <div class="flex items-center gap-8">
        <%= link_to root_path, class: "flex items-center gap-2 group shrink-0" do %>
          <img src="/icon2.png" alt="Actify Logo" class="w-8 h-8 object-contain group-hover:scale-105 transition-transform">
          <span class="text-2xl font-black tracking-tighter text-link group-hover:text-link-hover transition-colors">Actify</span>
        <% end %>

        <%# Header Search Form (Desktop only) %>
        <div class="hidden md:block relative">
          <%= form_tag events_path, method: :get, class: "relative" do %>
            <%= text_field_tag :query, params[:query], 
                placeholder: "Buscar eventos...", 
                class: "w-48 lg:w-72 pl-10 pr-4 py-2 bg-surface-secondary border border-border-light rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-xs font-semibold text-heading placeholder-muted shadow-inner" %>
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
          <% end %>
        </div>

        <%# Desktop Navigation Links (Public/Assistant) %>
        <div class="hidden lg:flex items-center gap-1">
          <%= link_to events_path, class: "px-4 py-2 text-sm font-bold text-body-tertiary hover:text-heading hover:bg-surface-secondary rounded-badge transition-all" do %>
            Explorar
          <% end %>

          <% if user_signed_in? && !current_user.organizer? %>
            <%= link_to bookings_path, class: "px-4 py-2 text-sm font-bold text-body-tertiary hover:text-heading hover:bg-surface-secondary rounded-badge transition-all" do %>
              Mis entradas
            <% end %>
          <% end %>

          <%# Categories Dropdown %>
          <div class="relative">
            <button type="button" 
                    data-action="click->navbar#toggleDropdown"
                    class="flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-body-tertiary hover:text-heading hover:bg-surface-secondary rounded-badge transition-all group">
              Categorías
              <svg class="w-4 h-4 text-muted group-hover:text-body-secondary transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <%# Dropdown Menu %>
            <div data-navbar-target="dropdown" 
                 class="hidden absolute top-full left-0 mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-border-light py-3 animate-in fade-in slide-in-from-top-2 duration-200 overflow-hidden">
              <div class="px-4 py-2 mb-2 border-b border-border-light">
                <span class="text-[10px] font-black uppercase tracking-widest text-muted">Seleccionar interés</span>
              </div>
              <div class="max-h-[60vh] overflow-y-auto custom-scrollbar">
                <% navbar_categories.each do |category| %>
                  <%= link_to events_path(category_id: category.id), class: "flex items-center gap-3 px-4 py-3 hover:bg-primary/10 group transition-colors" do %>
                    <div class="w-8 h-8 bg-surface-secondary rounded-card flex items-center justify-center text-muted group-hover:bg-primary/20 group-hover:text-link transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-bold text-body group-hover:text-link-hover transition-colors"><%= category.name %></p>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <%# Location Dropdown %>
          <div class="relative" data-controller="location" data-action="click@window->location#close">
            <% active_city = cookies[:selected_city] %>
            <button type="button" 
                    data-action="click->location#toggleDropdown"
                    class="flex items-center gap-1.5 px-4 py-2 text-sm font-bold <%= (selected_city_label != "Ubicación") ? 'text-link bg-primary/5' : 'text-body-tertiary' %> hover:text-heading hover:bg-surface-secondary rounded-badge transition-all group">
              <svg class="w-4 h-4 <%= (selected_city_label != "Ubicación") ? 'text-link' : 'text-muted' %> group-hover:text-body-secondary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span><%= selected_city_label %></span>
              <svg class="w-4 h-4 text-muted group-hover:text-body-secondary transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <%# Location Dropdown Menu %>
            <div data-location-target="dropdown" 
                 class="hidden absolute top-full left-0 mt-2 w-64 bg-white rounded-2xl shadow-2xl border border-border-light py-3 animate-in fade-in slide-in-from-top-2 duration-200 overflow-hidden z-50">
              
              <div class="px-4 py-2 mb-2 border-b border-border-light flex items-center justify-between">
                <span class="text-[10px] font-black uppercase tracking-widest text-muted">Filtrar por ciudad</span>
                <% if active_city.present? && active_city != "all" %>
                  <button type="button" 
                          data-action="click->location#select" 
                          data-location-city-param="all"
                          class="text-[10px] font-bold text-error hover:text-error transition-colors">
                    Limpiar
                  </button>
                <% end %>
              </div>

              <div class="max-h-[40vh] overflow-y-auto custom-scrollbar">
                <% navbar_cities.each do |city| %>
                  <% is_selected = city == active_city %>
                  <button type="button" 
                          data-action="click->location#select" 
                          data-location-city-param="<%= city %>"
                          class="w-full text-left flex items-center justify-between px-4 py-3 hover:bg-primary/10 group transition-colors <%= is_selected ? 'bg-primary/[0.03]' : '' %>">
                    <span class="text-sm font-bold <%= is_selected ? 'text-link' : 'text-body group-hover:text-link-hover' %> transition-colors">
                      <%= city %>
                    </span>
                    <% if is_selected %>
                      <svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                      </svg>
                    <% end %>
                  </button>
                <% end %>
                
                <% if navbar_cities.empty? %>
                  <p class="text-xs text-muted px-4 py-2 italic text-center">No hay ciudades con eventos</p>
                <% end %>
              </div>

              <div class="border-t border-border-light mt-2 pt-2 px-2">
                <button type="button" 
                        data-action="click->location#forceDetect"
                        class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-surface-secondary hover:bg-primary/10 text-xs font-bold text-body-secondary hover:text-link rounded-badge transition-all group">
                  <svg class="w-4 h-4 text-muted group-hover:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Detectar automáticamente
                </button>
              </div>

            </div>
          </div>

        </div>
      </div>

      <%# Right Side Actions %>
      <div class="hidden md:flex items-center gap-4">
        <% if user_signed_in? %>
          <% if current_user.admin? %>
            <%= link_to "Admin Panel", admin_dashboard_path, class: "px-4 py-2 text-xs font-black uppercase tracking-widest text-brand-plum bg-brand-plum/10 rounded-badge hover:bg-brand-plum/20 transition-all border border-brand-plum/20" %>
          <% elsif current_user.organizer? %>
            <%= link_to "Crear Evento", new_organizer_event_path, class: "px-4 py-2 text-xs font-black uppercase tracking-widest text-link bg-primary/10 rounded-badge hover:bg-primary/20 transition-all border border-primary/20" %>
          <% end %>

          <div class="flex items-center gap-3 ml-2 pl-6 border-l border-border-light">
            <%= link_to profile_path, class: "flex items-center gap-3 group" do %>
              <div class="w-10 h-10 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full flex items-center justify-center text-body-tertiary font-bold border-2 border-white shadow-raised group-hover:shadow-md transition-all">
                <%= current_user.name[0].upcase %>
              </div>
              <div class="hidden xl:block">
                <p class="text-xs font-black text-heading leading-none mb-1"><%= current_user.name %></p>
                <p class="text-[10px] font-bold text-muted uppercase tracking-tighter">Mi Cuenta</p>
              </div>
            <% end %>

            <%= button_to destroy_user_session_path, method: :delete,
                class: "p-2.5 text-muted hover:text-error hover:bg-error/10 rounded-badge transition-all",
                data: { 
                  turbo_confirm: "¿Estás seguro de que deseas cerrar tu sesión actual?",
                  turbo_confirm_title: "Cerrar sesión"
                } do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center gap-2">
            <%= link_to "Entrar", new_user_session_path, class: "px-6 py-2.5 text-sm font-bold text-body-secondary hover:text-heading transition-colors" %>
            <%= link_to "Registrarse", new_user_registration_path,
                class: "px-6 py-2.5 text-sm font-bold bg-primary text-white rounded-2xl hover:bg-primary-hover transition-all shadow-lg shadow-primary/20 active:scale-95" %>
          </div>
        <% end %>
      </div>

      <%# Mobile menu button %>
      <div class="lg:hidden">
        <button data-action="click->navbar#toggle" class="w-10 h-10 flex items-center justify-center text-body-tertiary bg-surface-secondary rounded-badge hover:bg-surface-secondary transition-all">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <%# Mobile Menu Overlay %>
  <div data-navbar-target="menu" class="hidden lg:hidden border-t border-border-light bg-white px-4 py-6 animate-in slide-in-from-top duration-300">
    <div class="space-y-4">
      <%# Mobile Search Form %>
      <div class="relative px-2">
        <%= form_tag events_path, method: :get, class: "relative" do %>
          <%= text_field_tag :query, params[:query], 
              placeholder: "Buscar eventos...", 
              class: "w-full pl-10 pr-4 py-3 bg-surface-secondary border border-border-light rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm font-semibold text-heading placeholder-muted shadow-inner" %>
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
        <% end %>
      </div>

      <%= link_to "Explorar", events_path, class: "block px-4 py-3 text-base font-bold text-body hover:bg-primary/10 hover:text-link rounded-badge transition-all" %>
      
      <%# Mobile Location Selector %>
      <div class="pt-4 pb-2 px-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-muted">Ubicación</span>
      </div>
      <div class="px-2" data-controller="location">
        <% active_city_mobile = cookies[:selected_city] %>
        <div class="relative">
          <button type="button" 
                  data-action="click->location#toggleDropdown"
                  class="w-full flex items-center justify-between px-4 py-3 text-sm font-bold text-body bg-surface-secondary hover:bg-surface-secondary rounded-badge transition-all">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-body-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span><%= selected_city_label(fallback: "Seleccionar Ciudad") %></span>
            </div>
            <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <%# Mobile Dropdown Menu %>
          <div data-location-target="dropdown" 
               class="hidden mt-2 bg-surface-secondary/50 border border-border-light rounded-2xl py-2 overflow-hidden space-y-1 z-50">
            <button type="button" 
                    data-action="click->location#select" 
                    data-location-city-param="all"
                    class="w-full text-left px-4 py-2.5 text-sm font-bold text-body-tertiary hover:bg-surface-secondary <%= (active_city_mobile.blank? || active_city_mobile == "all") ? 'text-link bg-primary/[0.03]' : '' %>">
              Todas las ciudades
            </button>
            <% navbar_cities.each do |city| %>
              <% is_selected = city == active_city_mobile %>
              <button type="button" 
                      data-action="click->location#select" 
                      data-location-city-param="<%= city %>"
                      class="w-full text-left px-4 py-2.5 text-sm font-bold text-body hover:bg-surface-secondary <%= is_selected ? 'text-link bg-primary/[0.03]' : '' %>">
                <%= city %>
              </button>
            <% end %>
            <button type="button" 
                    data-action="click->location#forceDetect"
                    class="w-full text-left px-4 py-2.5 text-xs font-black uppercase text-link bg-primary/10 hover:bg-primary/20 flex items-center gap-1.5 mt-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Detectar automáticamente
            </button>
          </div>
        </div>
      </div>

      <div class="pt-4 pb-2 px-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-muted">Categorías</span>
      </div>
      <div class="grid grid-cols-2 gap-2 px-2">
        <% navbar_categories.each do |category| %>
          <%= link_to category.name, events_path(category_id: category.id), class: "px-4 py-2 text-sm font-bold text-body-tertiary hover:bg-surface-secondary rounded-card" %>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <div class="pt-6 mt-6 border-t border-border-light space-y-2">
          <% unless current_user.organizer? %>
            <%= link_to "Mis entradas", bookings_path, class: "block px-4 py-3 text-base font-bold text-body hover:bg-primary/10 hover:text-link rounded-badge transition-all" %>
          <% end %>
          <%= link_to "Mi Perfil", profile_path, class: "block px-4 py-3 text-base font-bold text-body hover:bg-primary/10 hover:text-link rounded-badge transition-all" %>
          <% if current_user.admin? %>
            <%= link_to "Dashboard Admin", admin_dashboard_path, class: "block px-4 py-3 text-base font-bold text-brand-plum hover:bg-brand-plum/10 rounded-badge transition-all" %>
          <% elsif current_user.organizer? %>
            <%= link_to "Mis Eventos", organizer_events_path, class: "block px-4 py-3 text-base font-bold text-link hover:bg-primary/10 rounded-badge transition-all" %>
          <% end %>
          <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-3 text-base font-bold text-error hover:bg-error/10 rounded-badge transition-all" %>
        </div>
      <% else %>
        <div class="pt-6 mt-6 border-t border-border-light flex flex-col gap-3 px-2">
          <%= link_to "Iniciar sesión", new_user_session_path, class: "w-full py-3 text-center text-sm font-bold text-body-secondary" %>
          <%= link_to "Registrarse", new_user_registration_path, class: "w-full py-3 text-center text-sm font-bold bg-primary text-white rounded-2xl shadow-lg shadow-primary/20" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>