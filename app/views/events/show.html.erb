<%# Page-level Smooth Scroll %>
<style>
  html {
    scroll-behavior: smooth;
  }
</style>

<%# Event Detail Page - Eventbrite style %>
<%
  images = @event.event_images.to_a
  has_many = images.size > 1
%>

<div <%= "data-controller='carousel' data-carousel-index-value='0'".html_safe if has_many %>>

  <%# 1. Full-Bleed Banner Section %>
  <div class="relative w-full overflow-hidden bg-gray-950 h-[300px] md:h-[450px]">
    <%# Blurred background using the first image %>
    <% if images.any? %>
      <div class="absolute inset-0 select-none pointer-events-none overflow-hidden scale-110">
        <%= image_tag images.first.image_url, class: "w-full h-full object-cover blur-3xl opacity-35" %>
      </div>
    <% end %>

    <%# Nitid Foreground content (Carousel or Single Image) %>
    <div class="relative max-w-7xl mx-auto h-full flex items-center justify-center">
      <div class="w-full h-full max-w-4xl relative overflow-hidden">
      
      <%# Carousel Slides %>
      <% if images.any? %>
        <div class="w-full h-full relative">
          <% images.each_with_index do |img, idx| %>
            <div class="<%= has_many ? 'absolute inset-0 transition-opacity duration-250 ease-out' : 'relative w-full h-full' %>"
                 <%= "data-carousel-target='slide' style='#{idx == 0 ? "opacity:1;z-index:10" : "opacity:0;z-index:0;pointer-events:none"}'".html_safe if has_many %>>
              <%= image_tag img.image_url,
                  class: "w-full h-full object-contain md:object-cover",
                  alt: "#{@event.name} – imagen #{idx + 1}" %>
              <% if idx == 0 && has_many %>
                <div class="absolute top-4 left-4 flex items-center gap-1.5 px-3 py-1.5 bg-white/90 backdrop-blur-sm rounded-full shadow-raised z-10 select-none">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                  <span class="text-[10px] font-extrabold text-heading uppercase tracking-widest">Destacado</span>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Carousel Arrows %>
          <% if has_many %>
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/40 to-transparent pointer-events-none z-20"></div>

            <button type="button" data-action="click->carousel#prev"
                    class="absolute left-4 top-1/2 -translate-y-1/2 z-30 w-11 h-11 flex items-center justify-center bg-black/30 hover:bg-black/50 hover:scale-105 active:scale-95 backdrop-blur-md rounded-full transition-all text-white">
              <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>

            <button type="button" data-action="click->carousel#next"
                    class="absolute right-4 top-1/2 -translate-y-1/2 z-30 w-11 h-11 flex items-center justify-center bg-black/30 hover:bg-black/50 hover:scale-105 active:scale-95 backdrop-blur-md rounded-full transition-all text-white">
              <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
              </svg>
            </button>

            <%# Dots Indicator %>
            <div class="absolute bottom-4 inset-x-0 z-30 flex justify-center gap-2">
              <% images.each_with_index do |_, idx| %>
                <button type="button"
                        data-action="click->carousel#jump"
                        data-index="<%= idx %>"
                        data-carousel-target="dot"
                        class="w-2.5 h-2.5 rounded-full bg-white transition-all duration-200"
                        style="<%= idx == 0 ? 'opacity: 1; transform: scale(1.25);' : 'opacity: 0.4; transform: scale(1);' %>">
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-muted">
          <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      <% end %>

    </div>
  </div>
</div>

<%# 2. Main Content Layout %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"
     data-controller="share"
     data-share-url-value="<%= event_url(@event) %>"
     data-share-title-value="<%= @event.name %>">
  <%# Back Link %>
  <div class="mb-6">
    <%= link_to events_path, class: "inline-flex items-center gap-1.5 text-sm font-semibold text-body-tertiary hover:text-heading transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Volver a eventos</span>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    
    <%# Columna Izquierda: Detalles del Evento (8 columnas) %>
    <div class="lg:col-span-8 space-y-8">
      
      <%# Gallery Thumbnails (only if many images) %>
      <% if has_many %>
        <div class="flex gap-2.5 pb-2 border-b border-border/60 overflow-x-auto select-none">
          <% images.each_with_index do |img, idx| %>
            <button type="button"
                    data-action="click->carousel#jump"
                    data-index="<%= idx %>"
                    data-carousel-target="thumb"
                    class="shrink-0 w-18 h-12.5 rounded-xl overflow-hidden border-2 transition-all duration-150 active:scale-95 <%= idx == 0 ? 'border-primary opacity-100' : 'border-transparent opacity-60 hover:opacity-90' %>">
              <%= image_tag img.image_url, class: "w-full h-full object-cover", alt: "" %>
            </button>
          <% end %>
        </div>
      <% end %>

      <%# Title, Category & Ratings %>
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-4">
          <% if @event.category %>
            <span class="inline-flex px-3 py-1 bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider rounded-full">
              <%= @event.category.name %>
            </span>
          <% end %>

          <% if @event.average_rating > 0 %>
            <div class="flex items-center gap-1.5 bg-yellow-50 px-2.5 py-1 rounded-xl border border-yellow-100">
              <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <span class="text-xs font-bold text-yellow-700"><%= @event.average_rating %></span>
            </div>
          <% end %>
        </div>

        <h1 class="text-3xl md:text-4xl font-extrabold text-heading tracking-tight leading-tight"><%= @event.name %></h1>
      </div>

      <%# Organizer Card %>
      <div class="flex items-center justify-between gap-4 p-4.5 bg-surface-secondary rounded-2xl border border-border/60">
        <div class="flex items-center gap-3.5">
          <div class="w-13 h-13 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xl border border-primary/20 shrink-0 select-none">
            <%= @event.organizer.name.first.upcase %>
          </div>
          <div>
            <p class="text-xs text-body-tertiary">Organizado por</p>
            <p class="font-bold text-heading text-base leading-snug"><%= @event.organizer.name %></p>
            <p class="text-xs text-body-tertiary font-semibold mt-0.5"><%= pluralize(@event.organizer.organized_events.published.count, 'evento', plural: 'eventos') %> organizados</p>
          </div>
        </div>
        <button type="button" class="px-4 py-2 bg-white hover:bg-surface-secondary text-heading text-xs font-bold rounded-xl border border-border transition-colors shadow-sm active:scale-97">
          Seguir
        </button>
      </div>

      <%# Event Quick Details %>
      <div class="space-y-5 pt-2">
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-xl bg-primary/5 border border-primary/10 flex items-center justify-center text-primary shrink-0 select-none">
            <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-heading text-sm">Fecha y hora</h4>
            <p class="text-sm font-semibold text-body-secondary mt-0.5">
              <%= l(@event.start_date, format: :long) if @event.start_date %>
              <% if @event.end_date %>
                <br><span class="text-xs text-body-tertiary">Hasta:</span> <%= l(@event.end_date, format: :long) %>
              <% end %>
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-xl bg-primary/5 border border-primary/10 flex items-center justify-center text-primary shrink-0 select-none">
            <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-heading text-sm">Ubicación</h4>
            <p class="text-sm font-semibold text-body-secondary mt-0.5"><%= @event.address %></p>
            <p class="text-xs text-body-tertiary font-semibold"><%= @event.city %></p>
          </div>
        </div>

        <% if @event.max_capacity %>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-primary/5 border border-primary/10 flex items-center justify-center text-primary shrink-0 select-none">
              <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-heading text-sm">Capacidad del lugar</h4>
              <p class="text-sm font-semibold text-body-secondary mt-0.5"><%= @event.max_capacity %> personas en total</p>
            </div>
          </div>
        <% end %>
      </div>

      <hr class="border-border/60">

      <%# Description / General Info %>
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-heading">Información general</h2>
        <div class="prose prose-gray max-w-none text-body-secondary leading-relaxed text-sm md:text-base">
          <%= simple_format @event.description %>
        </div>
      </div>

      <hr class="border-border/60">

      <%# Ticket Types & Booking Section %>
      <div id="tickets-section" class="scroll-mt-24 space-y-4">
        <h2 class="text-xl font-bold text-heading">Tipos de entrada</h2>
        <% if @event.ticket_types.any? %>
          <div class="space-y-3.5">
            <% @event.ticket_types.ordered.on_sale.each do |tt| %>
              <div class="p-5 bg-white border border-border rounded-2xl hover:border-primary/30 hover:shadow-raised transition-all flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="min-w-0 flex-1 space-y-1">
                  <h3 class="font-bold text-heading text-base leading-snug"><%= tt.name %></h3>
                  <p class="text-xs text-body-tertiary font-semibold">
                    <% if tt.available? %>
                      <%= tt.remaining_capacity %> disponibles
                      <% if tt.max_per_order.present? %>
                        · máx. <%= tt.max_per_order %> por persona
                      <% end %>
                    <% else %>
                      <span class="text-error font-bold">Agotado</span>
                    <% end %>
                  </p>
                </div>
                <div class="flex items-center justify-between sm:justify-end gap-6 shrink-0 pt-3 sm:pt-0 border-t border-border/55 sm:border-0">
                  <p class="text-lg font-black <%= tt.price > 0 ? "text-heading" : "text-success" %>">
                    <%= tt.price > 0 ? number_to_currency(tt.price, unit: "S/ ") : "Gratis" %>
                  </p>
                  <% if user_signed_in? && tt.available? && @event.available? %>
                    <%= link_to "Comprar",
                        new_event_booking_path(@event, ticket_type_id: tt.id),
                        class: "inline-flex px-5 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-primary-hover transition-all shadow-md shadow-primary/10 active:scale-95" %>
                  <% elsif !user_signed_in? && tt.available? %>
                    <%= link_to "Inicia sesión", new_user_session_path, class: "inline-flex px-5 py-2.5 bg-surface-secondary hover:bg-surface-tertiary text-heading text-xs font-bold uppercase tracking-wider rounded-xl transition-all border border-border" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-6 bg-surface-secondary rounded-2xl border border-border/60 text-center">
            <p class="text-sm font-semibold text-body-tertiary">No hay entradas a la venta para este evento.</p>
          </div>
        <% end %>
      </div>

      <hr class="border-border/60">

      <%# Leaflet Map %>
      <% if @event.latitude.present? && @event.longitude.present? %>
        <div class="space-y-4" data-controller="event-detail" 
             data-lat="<%= @event.latitude %>" 
             data-lng="<%= @event.longitude %>"
             data-restaurants="<%= @nearby_restaurants.to_json %>"
             data-hotels="<%= (@nearby_hotels.is_a?(Array) ? @nearby_hotels : @nearby_hotels.to_h['results']).to_json %>">
          <h2 class="text-xl font-bold text-heading">Ubicación en mapa</h2>
          <div data-event-detail-target="mapContainer" class="relative w-full h-[300px] rounded-2xl border border-border overflow-hidden shadow-sm transition-all duration-300">
            <div id="event-map" data-event-detail-target="mapElement" class="w-full h-full"></div>
            <button type="button" data-action="click->event-detail#toggleFullscreen" 
                    class="absolute top-3 right-3 z-[1000] w-10 h-10 rounded-xl bg-white/95 hover:bg-white hover:scale-105 active:scale-95 text-heading shadow-md flex items-center justify-center transition-all border border-border/50">
              <svg class="w-5.5 h-5.5 text-body" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path data-event-detail-target="fullscreenIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
              </svg>
            </button>
            
            <%# Leyenda Flotante del Ecosistema %>
            <div class="absolute bottom-3 left-3 z-[1000] bg-white/95 backdrop-blur-md p-2.5 rounded-xl shadow-lg border border-border/50 text-[10px] sm:text-xs font-bold text-heading flex flex-col gap-2">
              <button data-action="click->event-detail#centerMap" class="flex items-center gap-2 hover:bg-gray-100 p-1 -m-1 rounded-lg transition-colors text-left cursor-pointer w-full">
                <span class="flex items-center justify-center w-5 h-5 rounded-full bg-red-600 shadow-sm border-2 border-white text-white text-[10px]">📍</span> <span>Sede del Evento</span>
              </button>
              <button data-action="click->event-detail#toggleHotels" data-event-detail-target="hotelBtn" class="flex items-center gap-2 hover:bg-gray-100 p-1 -m-1 rounded-lg transition-colors text-left cursor-pointer w-full opacity-50">
                <span class="flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 shadow-sm border-2 border-white text-white text-[10px]">🏨</span> <span>Hospedajes (Hospy)</span>
              </button>
              <button data-action="click->event-detail#toggleRestaurants" data-event-detail-target="restaurantBtn" class="flex items-center gap-2 hover:bg-gray-100 p-1 -m-1 rounded-lg transition-colors text-left cursor-pointer w-full opacity-50">
                <span class="flex items-center justify-center w-5 h-5 rounded-full bg-orange-500 shadow-sm border-2 border-white text-white text-[10px]">🍽️</span> <span>Restaurantes (RestoPoint)</span>
              </button>
            </div>
          </div>
          <% if user_signed_in? %>
            <div class="flex flex-col sm:flex-row gap-3 mt-3">
              <button type="button" data-action="click->event-detail#showUserRoute" class="flex-1 flex justify-center items-center gap-2 bg-primary text-white px-4 py-2 rounded-xl font-bold hover:bg-primary-dark transition-colors shadow-sm text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                Mostrar mi distancia al evento
              </button>
              <a href="https://www.google.com/maps/dir/?api=1&destination=<%= @event.latitude %>,<%= @event.longitude %>" target="_blank" rel="noopener noreferrer" class="flex-1 flex justify-center items-center gap-2 bg-surface border border-border text-heading px-4 py-2 rounded-xl font-bold hover:bg-surface-secondary transition-colors shadow-sm text-sm">
                <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C7.58 0 4 3.58 4 8c0 5.25 8 16 8 16s8-10.75 8-16c0-4.42-3.58-8-8-8zm0 11.5c-1.93 0-3.5-1.57-3.5-3.5S10.07 4.5 12 4.5 15.5 6.07 15.5 8 13.93 11.5 12 11.5z"/></svg>
                Navegación en Google Maps
              </a>
            </div>
          <% end %>
        </div>
        <hr class="border-border/60">
      <% end %>

      <hr class="border-border/60 my-10">

      <div class="mb-8" id="planifica-tu-viaje">
        <h2 class="text-2xl font-bold text-heading">Planifica tu Viaje</h2>
        <p class="text-body-secondary mt-2">Prueba de Concepto: Mocks de Plataformas del Ecosistema Turístico (Movilidad / Praxis)</p>
      </div>

      <%# Ecosystem Tabs %>
      <div class="mt-8 mb-12" data-controller="ecosystem-tabs" 
           data-ecosystem-tabs-active-tab-class="border-indigo-600 text-indigo-600 bg-indigo-50" 
           data-ecosystem-tabs-inactive-tab-class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
           data-ecosystem-tabs-active-panel-class="block" 
           data-ecosystem-tabs-inactive-panel-class="hidden">
        
        <div class="border-b border-gray-200">
          <nav class="-mb-px flex space-x-8 overflow-x-auto hide-scrollbar" aria-label="Tabs">
            <% if @nearby_hotels.present? %>
            <button data-ecosystem-tabs-target="tab" data-action="click->ecosystem-tabs#select" data-tab-id="hospy" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-black transition-colors flex items-center gap-2">
              <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z"/></svg> Hospedajes
            </button>
            <% end %>
            <% if @nearby_restaurants.present? %>
            <button data-ecosystem-tabs-target="tab" data-action="click->ecosystem-tabs#select" data-tab-id="restopoint" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-black transition-colors flex items-center gap-2">
              <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg> Dónde Comer
            </button>
            <% end %>
            <% if @tourism_data.present? && @tourism_data['data'].present? %>
            <button data-ecosystem-tabs-target="tab" data-action="click->ecosystem-tabs#select" data-tab-id="conectatingo" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-black transition-colors flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Turismo
            </button>
            <% end %>
            <button data-ecosystem-tabs-target="tab" data-action="click->ecosystem-tabs#select" data-tab-id="vehiculos" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-black transition-colors flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Movilidad (Mocks)
            </button>
          </nav>
        </div>

        <div class="mt-6">

      <%# Hospy Nearby Accommodations %>
      <% hospy_results = @nearby_hotels.is_a?(Array) ? @nearby_hotels : @nearby_hotels.to_h['results'] %>
      <% if hospy_results.present? %>
        <div data-ecosystem-tabs-target="panel" data-tab-id="hospy">
        <div class="bg-gradient-to-br from-indigo-50 to-blue-100 rounded-3xl border border-indigo-200/60 p-6 md:p-8 space-y-6 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-indigo-500 text-white flex items-center justify-center shadow-lg shadow-indigo-500/20 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1v1H9V7zm5 0h1v1h-1V7zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1zm-5 4h1v1H9v-1zm5 0h1v1h-1v-1z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-black text-indigo-950">Alojamientos Cercanos</h2>
              <p class="text-sm font-semibold text-indigo-800/80">Recomendaciones impulsadas por Hospy</p>
            </div>
          </div>
          
          <div class="flex gap-4 overflow-x-auto pb-4 snap-x hide-scrollbar">
            <% hospy_results.take(4).each_with_index do |hotel, index| %>
              <div class="min-w-[240px] max-w-[240px] bg-white rounded-2xl border border-indigo-100 shadow-sm shrink-0 snap-start overflow-hidden flex flex-col group transition-transform duration-300 hover:-translate-y-1"
                   data-action="mouseenter->event-detail#highlightPin mouseleave->event-detail#resetPin" 
                   data-marker-id="hotel-<%= index %>">
                <div class="h-32 bg-indigo-100 relative overflow-hidden">
                  <% if hotel['foto_principal'] %>
                    <img src="<%= hotel['foto_principal'] %>" alt="<%= hotel['name'] %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-indigo-300">
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                  <% end %>
                  <div class="absolute top-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg text-xs font-bold text-heading flex items-center gap-1 shadow-sm">
                    <span class="text-yellow-500">★</span> <%= hotel['average_rating'] || "Nuevo" %>
                  </div>
                </div>
                <div class="p-4 flex-1 flex flex-col">
                  <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 mb-1"><%= hotel['type'] %></p>
                  <h3 class="font-bold text-heading text-sm line-clamp-1 mb-2"><%= hotel['name'] %></h3>
                  <div class="mt-auto flex items-end justify-between">
                    <div>
                      <p class="text-[10px] font-semibold text-body-tertiary">Desde</p>
                      <p class="font-bold text-indigo-700 leading-none"><%= number_to_currency(hotel['precio_desde'], unit: "S/ ") %></p>
                    </div>
                  </div>
                  <div class="mt-3 space-y-1.5">
                    <% 
                      entrada = @event.start_date.strftime('%Y-%m-%d')
                      salida = (@event.end_date || @event.start_date + 2.days).strftime('%Y-%m-%d')
                    %>
                    <a href="https://hospy.pages.dev/hospedajes/<%= hotel['id'] %>?entrada=<%= entrada %>&salida=<%= salida %>" target="_blank" rel="noopener noreferrer" class="w-full py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 flex items-center justify-center gap-1.5 font-bold text-[10px] uppercase tracking-wider rounded-lg transition-colors">
                      Visitar Hospy
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        </div>
      <% end %>

      <%# Nearby Restaurants (API) %>
      <% if @nearby_restaurants.present? %>
        <div data-ecosystem-tabs-target="panel" data-tab-id="restopoint" class="hidden">
        <div class="bg-gradient-to-br from-orange-50 to-amber-100 rounded-3xl border border-orange-200/60 p-6 md:p-8 space-y-6 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-orange-500 text-white flex items-center justify-center shadow-lg shadow-orange-500/20 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-black text-orange-950">Dónde comer</h2>
              <p class="text-sm font-semibold text-orange-800/80">Restaurantes recomendados a menos de 3 km</p>
            </div>
          </div>
          
          <div class="flex gap-4 overflow-x-auto pb-4 snap-x hide-scrollbar">
            <% @nearby_restaurants.each_with_index do |restaurant, index| %>
              <div class="min-w-[240px] max-w-[240px] bg-white rounded-2xl border border-orange-100 shadow-sm shrink-0 snap-start overflow-hidden flex flex-col group transition-transform duration-300 hover:-translate-y-1"
                   data-action="mouseenter->event-detail#highlightPin mouseleave->event-detail#resetPin" 
                   data-marker-id="restaurant-<%= index %>">
                <div class="h-32 bg-orange-100 relative overflow-hidden">
                  <div class="w-full h-full flex items-center justify-center text-orange-300">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                  </div>
                  <div class="absolute top-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg text-xs font-bold text-heading flex items-center gap-1 shadow-sm">
                    <span class="text-yellow-500">★</span> <%= restaurant['avgRating'] || "Nuevo" %>
                  </div>
                </div>
                <div class="p-4 flex-1 flex flex-col">
                  <p class="text-[10px] font-black uppercase tracking-widest text-orange-500 mb-1 flex items-center gap-1">
                    🚶 A <%= (restaurant['distance_km'].to_f * 12).round %> min caminando
                  </p>
                  <h3 class="font-bold text-heading text-sm line-clamp-1 mb-1"><%= restaurant['name'] %></h3>
                  <div class="mt-auto pt-3 space-y-1.5">
                    <a href="https://restaurants-seven-tan.vercel.app/restaurants/<%= restaurant['name'].parameterize %>" target="_blank" rel="noopener noreferrer" class="w-full py-1.5 bg-gray-50 hover:bg-gray-100 text-gray-700 flex items-center justify-center gap-1.5 font-bold text-[10px] uppercase tracking-wider rounded-lg transition-colors">
                      Visitar RestoPoint
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        </div>
      <% end %>

      <%# Travel Assistant (ConectaTingo Integration) %>
      <% if @tourism_data.present? && @tourism_data['data'].present? %>
        <div data-ecosystem-tabs-target="panel" data-tab-id="conectatingo" class="hidden">
        <div class="bg-gradient-to-br from-emerald-50 to-teal-100 rounded-3xl border border-emerald-200/60 p-6 md:p-8 space-y-6 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/20">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h2 class="text-xl font-black text-emerald-950">Aprovecha tu viaje a Tingo María</h2>
              <p class="text-sm font-semibold text-emerald-800/80">Recomendaciones exclusivas impulsadas por ConectaTingo</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%# Route Recommendation %>
            <% route = @tourism_data.dig('data', 'movilidad', 'metricas')&.first %>
            <% if route %>
              <div class="bg-white rounded-2xl p-5 border border-emerald-100 shadow-sm flex flex-col justify-center group relative">
                <p class="text-[10px] font-black uppercase tracking-widest text-emerald-500 mb-2">Ruta Sugerida</p>
                <a href="<%= route['url_detalle'] || 'https://conectatingo.com' %>" target="_blank" rel="noopener noreferrer" class="font-bold text-heading text-base hover:text-emerald-600 transition-colors inline-flex items-center gap-1.5">
                  <%= route['circuito'] %>
                  <svg class="w-4 h-4 text-emerald-500/0 group-hover:text-emerald-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
                <p class="text-xs text-body-secondary mt-1"><%= route['descripcion'] %> · <span class="font-bold text-emerald-700"><%= route['duracion'] %></span></p>
              </div>
            <% end %>

            <%# Hotspots %>
            <% hotspots = @tourism_data.dig('data', 'hoteles', 'metricas')&.first(3) %>
            <% if hotspots.present? %>
              <div class="bg-white rounded-2xl p-5 border border-emerald-100 shadow-sm">
                <p class="text-[10px] font-black uppercase tracking-widest text-emerald-500 mb-3">Imperdibles cerca del evento</p>
                <ul class="space-y-3">
                  <% hotspots.each do |spot| %>
                    <% price_info = @tourism_data.dig('data', 'eventos', 'metricas')&.find { |e| e['lugar'] == spot['destino'] } %>
                    <li class="flex justify-between items-center border-b border-border-light/50 pb-2 last:border-0 last:pb-0 group">
                      <a href="<%= spot['url_detalle'] || 'https://conectatingo.com' %>" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-bold text-heading text-sm hover:text-emerald-600 transition-colors">
                        <%= spot['destino'] %>
                        <svg class="w-3.5 h-3.5 text-emerald-500/0 group-hover:text-emerald-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </a>
                      <span class="px-2 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg whitespace-nowrap"><%= price_info ? price_info['precio_entrada'] : "Consultar" %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>
        </div>
      <% end %>

      <%# Ecosistema (Mocks PoC) %>
      <div data-ecosystem-tabs-target="panel" data-tab-id="vehiculos" class="hidden">
        <div class="mb-12">
        
        <turbo-frame id="ecosystem_mocks" src="<%= event_ecosystem_mocks_path(@event) %>" loading="lazy">
          <div class="animate-pulse flex gap-4 overflow-x-auto pb-4">
            <div class="w-72 h-40 bg-surface-secondary rounded-2xl shrink-0"></div>
            <div class="w-72 h-40 bg-surface-secondary rounded-2xl shrink-0"></div>
            <div class="w-72 h-40 bg-surface-secondary rounded-2xl shrink-0"></div>
          </div>
        </turbo-frame>
      </div>
      </div> <!-- end mock panel div -->

        </div> <!-- end tabs content wrapper -->
      </div> <!-- end tabs controller wrapper -->
      <hr class="border-border/60 my-6">

      <%# Comments Section %>
      <div class="bg-surface-secondary/35 rounded-3xl border border-border/60 p-6 md:p-8 space-y-6">
        <h2 class="text-xl font-bold text-heading">
          Comentarios (<%= @comments.count %>)
        </h2>

        <%# Comment Form %>
        <% if user_signed_in? %>
          <% if @comments.none? { |c| c.user_id == current_user.id } %>
            <div data-event-detail-target="commentForm">
              <%= form_with model: [@event, @comment], local: true, class: "p-5 bg-white rounded-2xl border border-border space-y-4 shadow-sm" do |f| %>
                <h3 class="font-bold text-heading text-sm">Dejá tu opinión del evento</h3>

                <%# Star Rating %>
                <div data-event-detail-target="starsContainer" class="space-y-1.5">
                  <p class="text-xs font-bold text-body-tertiary uppercase tracking-wider">Tu valoración</p>
                  <div class="flex gap-1">
                    <% 5.times do |i| %>
                      <button type="button"
                              data-action="click->event-detail#rate mouseenter->event-detail#highlightStars mouseleave->event-detail#resetStars"
                              data-event-detail-target="star"
                              data-rating="<%= i + 1 %>"
                              data-event-detail-rating-param="<%= i + 1 %>"
                              class="text-2xl text-muted hover:text-yellow-400 transition-colors">
                        ★
                      </button>
                    <% end %>
                  </div>
                  <%= f.hidden_field :rating, value: 0, data: { event_detail_target: "ratingInput" } %>
                </div>

                <%# Comment Content %>
                <div class="space-y-1">
                  <label class="block text-xs font-bold text-body-tertiary uppercase tracking-wider">Comentario</label>
                  <%= f.text_area :content, rows: 3,
                      placeholder: "Contanos tu experiencia... (mín. 10 caracteres)",
                      class: "w-full border border-border-input rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary font-medium" %>
                </div>

                <%= f.submit "Publicar comentario",
                    class: "px-5 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-primary-hover transition-all active:scale-97" %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="p-6 bg-white rounded-2xl border border-border text-center shadow-sm">
            <p class="text-sm font-semibold text-body-secondary">
              <%= link_to "Iniciá sesión", new_user_session_path, class: "text-primary hover:underline font-bold" %> para dejar tu comentario.
            </p>
          </div>
        <% end %>

        <%# Comments List %>
        <% if @comments.any? %>
          <div class="space-y-4">
            <%= render partial: "comments/comment", collection: @comments, as: :comment %>
          </div>
        <% else %>
          <p class="text-center text-sm font-semibold text-body-tertiary py-8 select-none">No hay comentarios aún. ¡Sé el primero en opinar!</p>
        <% end %>
      </div>

    </div>

    <%# Columna Derecha: Sticky Booking Widget (4 columnas) %>
    <div class="lg:col-span-4 lg:sticky lg:top-28 space-y-6">
      <div class="bg-white rounded-badge border border-border p-6 shadow-md space-y-6">
        
        <%# Price Summary %>
        <div class="space-y-1">
          <p class="text-[10px] font-extrabold text-body-tertiary uppercase tracking-widest">Precio</p>
          <p class="text-2xl font-black text-heading leading-none">
            <% if (range = @event.price_range) %>
              <% if range.is_a?(Range) %>
                Desde <%= number_to_currency(range.first, unit: "S/ ") %>
              <% else %>
                <%= range > 0 ? number_to_currency(range, unit: "S/ ") : "Gratis" %>
              <% end %>
            <% else %>
              Gratis
            <% end %>
          </p>
        </div>

        <%# Date Summary %>
        <div class="space-y-1">
          <p class="text-[10px] font-extrabold text-body-tertiary uppercase tracking-widest">Fecha</p>
          <p class="text-sm font-bold text-body-secondary leading-snug">
            <%= l(@event.start_date, format: "%d de %b, %H:%M hs") if @event.start_date %>
          </p>
        </div>

        <%# Main CTA Button %>
        <% if @event.ticket_types.any? && @event.available? %>
          <a href="#tickets-section" class="w-full py-3.5 bg-primary hover:bg-primary-hover text-white text-center font-bold text-sm uppercase tracking-wider rounded-xl transition-all duration-150 shadow-lg shadow-primary/20 block hover:scale-[1.01] active:scale-[0.99]">
            Conseguir entradas
          </a>
        <% else %>
          <button disabled class="w-full py-3.5 bg-surface-secondary text-body-tertiary text-center font-bold text-sm uppercase tracking-wider rounded-xl block cursor-not-allowed border border-border select-none">
            No disponible
          </button>
        <% end %>

        <%# Secondary Share & Favorite Actions %>
        <div class="flex items-center justify-center gap-6 border-t border-border pt-4 select-none">
          <button type="button"
                  data-action="click->share#share"
                  class="flex items-center gap-2 text-sm font-bold text-body-secondary hover:text-primary transition-colors group">
            <svg class="w-5 h-5 text-body-tertiary group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M15.75 4.5a3 3 0 11.825 2.066l-8.421 4.679a3.002 3.002 0 010 1.51l8.421 4.679a3 3 0 11-.729 1.31l-8.421-4.678a3 3 0 110-4.132l8.421-4.679a3 3 0 01-.096-.755z" clip-rule="evenodd" />
            </svg>
            <span>Compartir</span>
          </button>
          
          <%= turbo_frame_tag "event_#{@event.id}_favorite" do %>
            <% if user_signed_in? %>
              <% is_fav = current_user.favorites.exists?(event: @event) %>
              <%= button_to favorite_event_path(@event),
                            method: :post,
                            class: "flex items-center gap-2 text-sm font-bold #{is_fav ? 'text-error' : 'text-body-secondary'} hover:text-error transition-colors group",
                            data: { turbo_frame: "event_#{@event.id}_favorite" } do %>
                <svg class="w-5 h-5 #{is_fav ? 'text-error fill-current animate-[heartbeat_0.3s_ease-in-out]' : 'text-body-tertiary group-hover:text-error group-hover:scale-110'} transition-all" fill="<%= is_fav ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span>Favorito</span>
              <% end %>
            <% else %>
              <%= button_to favorite_event_path(@event),
                            method: :post,
                            class: "flex items-center gap-2 text-sm font-bold text-body-secondary hover:text-error transition-colors group",
                            data: { turbo: false } do %>
                <svg class="w-5 h-5 text-body-tertiary group-hover:text-error group-hover:scale-110 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span>Favorito</span>
              <% end %>
            <% end %>
          <% end %>
        </div>

      </div>

      <%# PoC Ecosistema Widget %>
      <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-badge border border-indigo-400 p-6 shadow-lg relative overflow-hidden group">
        <div class="absolute -right-4 -top-4 text-white/20 group-hover:scale-110 transition-transform duration-500">
          <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="relative z-10">
          <h4 class="text-white font-bold mb-1">Planifica tu Viaje</h4>
          <p class="text-indigo-100 text-xs mb-4">Descubre opciones de transporte, hospedaje y turismo cerca del evento.</p>
          <a href="#planifica-tu-viaje" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white text-xs font-bold py-2 px-4 rounded-lg backdrop-blur-sm transition-colors border border-white/20">
            Explorar el Ecosistema
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          </a>
        </div>
      </div>
    </div>

  </div>



  <%# Share Modal Fallback %>
  <div data-share-target="modal" 
       class="hidden fixed inset-0 z-[200] items-center justify-center p-4 bg-gray-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-out">
    <div class="modal-content scale-95 opacity-0 bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden transition-[transform,opacity] duration-300 ease-out">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold text-heading">Compartir evento</h3>
          <button type="button" data-action="click->share#closeModal" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-secondary text-muted hover:text-heading transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        
        <p class="text-xs text-body-tertiary font-bold uppercase tracking-wider mb-3">Redes sociales</p>
        <div class="grid grid-cols-3 gap-3 mb-6">
          <%# WhatsApp %>
          <a href="https://api.whatsapp.com/send?text=<%= url_encode("#{@event.name} #{event_url(@event)}") %>" 
             target="_blank" rel="noopener"
             class="flex flex-col items-center justify-center p-4 rounded-2xl border border-border hover:border-emerald-200 hover:bg-emerald-50/30 transition-all group">
            <span class="w-10 h-10 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/10 group-hover:scale-105 transition-transform mb-2">
              <svg class="w-5.5 h-5.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.625 1.45 5.467-.003 9.923-4.45 9.927-9.913.002-2.646-1.027-5.133-2.9-7.008C16.427 1.809 13.94.779 11.298.779 5.828.779 1.374 5.23 1.372 10.7c-.001 1.739.46 3.432 1.336 4.93l-.875 3.197 3.284-.861c1.47.8 2.923 1.188 4.93 1.188zm11.366-8.06c-.33-.165-1.951-.963-2.251-1.07-.3-.108-.518-.162-.737.165-.218.328-.844 1.07-.1.07-.15-.165-.18-.328-.51-.493-.3-.165-1.337-.492-2.546-1.57-1.01-.9-1.69-2.01-1.889-2.34-.198-.329-.021-.507.144-.672.148-.148.33-.384.495-.576.165-.192.219-.329.33-.548.11-.219.055-.411-.027-.575-.083-.165-.737-1.775-1.01-2.433-.267-.641-.539-.553-.737-.563-.19-.009-.41-.01-.628-.01-.22 0-.576.082-.878.411-.3.33-1.153 1.123-1.153 2.738 0 1.616 1.173 3.178 1.338 3.4.165.22 2.307 3.522 5.589 4.938.78.337 1.39.538 1.86.687.784.249 1.498.214 2.062.13.629-.094 1.951-.798 2.225-1.57.275-.772.275-1.436.193-1.571-.083-.136-.3-.22-.63-.385z"/>
              </svg>
            </span>
            <span class="text-xs font-bold text-body-secondary group-hover:text-emerald-700">WhatsApp</span>
          </a>
          <%# Facebook %>
          <a href="https://www.facebook.com/sharer/sharer.php?u=<%= url_encode(event_url(@event)) %>" 
             target="_blank" rel="noopener"
             class="flex flex-col items-center justify-center p-4 rounded-2xl border border-border hover:border-blue-200 hover:bg-blue-50/30 transition-all group">
            <span class="w-10 h-10 rounded-full bg-[#1877F2] text-white flex items-center justify-center shadow-lg shadow-[#1877F2]/10 group-hover:scale-105 transition-transform mb-2">
              <svg class="w-5.5 h-5.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </span>
            <span class="text-xs font-bold text-body-secondary group-hover:text-blue-700">Facebook</span>
          </a>
          <%# X / Twitter %>
          <a href="https://twitter.com/intent/tweet?text=<%= url_encode("¡No te pierdas este evento: #{@event.name}!") %>&url=<%= url_encode(event_url(@event)) %>" 
             target="_blank" rel="noopener"
             class="flex flex-col items-center justify-center p-4 rounded-2xl border border-border hover:border-gray-800 hover:bg-gray-50 transition-all group">
            <span class="w-10 h-10 rounded-full bg-black text-white flex items-center justify-center shadow-lg shadow-black/10 group-hover:scale-105 transition-transform mb-2">
              <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </span>
            <span class="text-xs font-bold text-body-secondary group-hover:text-black">Twitter / X</span>
          </a>
        </div>
        
        <p class="text-xs text-body-tertiary font-bold uppercase tracking-wider mb-3">Enlace del evento</p>
        <div class="flex gap-2">
          <input type="text" readonly value="<%= event_url(@event) %>" 
                 class="flex-1 bg-surface-secondary border border-border rounded-xl px-4 py-2.5 text-sm font-medium text-body-secondary select-all focus:outline-none focus:border-primary/40 focus:ring-2 focus:ring-primary/10">
          <button type="button" data-share-target="copyButton" data-action="click->share#copy"
                  class="px-5 py-2.5 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-xl hover:bg-primary-hover transition-all flex items-center justify-center border border-transparent shadow-md shadow-primary/10 active:scale-95 shrink-0">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 00-2 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
            </svg>
            Copiar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
</div>