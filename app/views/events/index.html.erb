<%# Events Index - Explore Page %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="explore">
  <%# Page Header %>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-heading">Explorar eventos</h1>
      <p class="mt-1 text-body-tertiary">Descubrí eventos increíbles cerca tuyo</p>
    </div>

    <%# View Toggle (visible only on mobile/tablet) %>
    <div class="flex items-center gap-1 bg-surface-secondary rounded-card p-1 lg:hidden">
      <button type="button" data-action="click->explore#toggleView" data-explore-mode-param="list" data-explore-target="viewToggle"
              class="px-3 py-1.5 text-sm font-semibold rounded-md bg-white text-heading shadow-raised explore-view-btn">
        <svg class="w-4.5 h-4.5 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
        </svg>
        Lista
      </button>
      <button type="button" data-action="click->explore#toggleView" data-explore-mode-param="map" data-explore-target="viewToggle"
              class="px-3 py-1.5 text-sm font-semibold rounded-md text-body-secondary hover:text-heading explore-view-btn">
        <svg class="w-4.5 h-4.5 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
        Mapa
      </button>
    </div>
  </div>

  <%# Main Grid Layout %>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <%# Sidebar Filters %>
    <div class="col-span-12 lg:col-span-3">
      <%= render "events/filters" %>
    </div>

    <%# Content Container (List and Map) %>
    <div class="col-span-12 lg:col-span-9">
      
      <%# Loading indicator %>
      <div id="loading-indicator" class="hidden text-center py-8">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-primary border-t-transparent"></div>
        <p class="mt-2 text-sm text-body-tertiary">Buscando eventos...</p>
      </div>

      <div class="grid grid-cols-1 <%= @events.any? ? 'lg:grid-cols-12' : '' %> gap-8">
        
        <%# Results List Column %>
        <div class="<%= @events.any? ? 'lg:col-span-7' : 'w-full' %> space-y-6" data-explore-target="resultsGrid">
          
          <%# Active Filters Badges %>
          <% active_filters = [] %>
          <% if params[:query].present? %>
            <% active_filters << { label: "Búsqueda: #{params[:query]}", param: :query } %>
          <% end %>
          <% if params[:city].present? && params[:city] != "all" %>
            <% active_filters << { label: "Ciudad: #{params[:city]}", param: :city } %>
          <% end %>
          <% if params[:category_id].present? %>
            <% category = Category.find_by(id: params[:category_id]) %>
            <% active_filters << { label: "Categoría: #{category.name}", param: :category_id } if category %>
          <% end %>
          <% if params[:date_option].present? && params[:date_option] != "all" %>
            <% label_date = case params[:date_option]
                            when "today" then "Hoy"
                            when "tomorrow" then "Mañana"
                            when "weekend" then "Este fin de semana"
                            when "custom" then "Fecha: #{params[:start_date]} a #{params[:end_date]}"
                            end %>
            <% active_filters << { label: label_date, param: :date_option } %>
          <% end %>
          <% if params[:price_option].present? && params[:price_option] != "all" %>
            <% label_price = case params[:price_option]
                             when "free" then "Gratis"
                             when "paid" then "De pago"
                             when "custom" then "Precio: S/#{params[:price_min]} a S/#{params[:price_max]}"
                             end %>
            <% active_filters << { label: label_price, param: :price_option } %>
          <% end %>

          <% if active_filters.any? %>
            <div class="flex flex-wrap items-center gap-2 bg-surface-secondary/50 p-3 rounded-2xl border border-border/60">
              <span class="text-xs font-bold text-body-tertiary uppercase mr-1">Filtros activos:</span>
              <% active_filters.each do |filter| %>
                <% remove_params = params.except(:controller, :action).permit!.to_h %>
                <% case filter[:param]
                   when :date_option
                     remove_params.delete(:date_option)
                     remove_params.delete(:start_date)
                     remove_params.delete(:end_date)
                   when :price_option
                     remove_params.delete(:price_option)
                     remove_params.delete(:price_min)
                     remove_params.delete(:price_max)
                   else
                     remove_params.delete(filter[:param])
                   end %>
                <%= link_to events_path(remove_params), class: "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white text-heading hover:bg-surface-secondary transition-colors border border-border shadow-sm" do %>
                  <span><%= filter[:label] %></span>
                  <svg class="w-3 h-3 text-muted hover:text-heading" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                <% end %>
              <% end %>
              <%= link_to "Limpiar todos", events_path, class: "text-xs font-bold text-error hover:underline ml-2" %>
            </div>
          <% end %>

          <% if @events.any? %>
            <div class="space-y-6">
              <%= render partial: "events/event_card_horizontal", collection: @events, as: :event %>
            </div>

            <%# Pagination %>
            <div class="mt-8">
              <%= paginate @events %>
            </div>
          <% else %>
            <%# PREMIUM EMPTY STATE %>
            <div class="space-y-8">
              <div class="bg-white rounded-badge border border-border p-8 text-center shadow-sm space-y-6">
                <div class="w-16 h-16 mx-auto bg-surface-secondary rounded-full flex items-center justify-center text-muted">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                
                <div class="space-y-2">
                  <h3 class="text-xl font-bold text-heading">No se encontraron eventos</h3>
                  <p class="text-sm text-body-tertiary max-w-md mx-auto">
                    No hay resultados para la combinación de filtros aplicada en <%= selected_city_label %>.<br>
                    Intentá buscando con términos más amplios o removiendo algunos filtros.
                  </p>
                </div>

                <% if @suggested_query.present? %>
                  <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 rounded-full text-sm font-semibold text-primary">
                    <span>¿Quisiste decir?</span>
                    <% suggest_params = params.except(:controller, :action).permit!.to_h.merge(query: @suggested_query) %>
                    <%= link_to @suggested_query, events_path(suggest_params), class: "underline hover:text-primary-hover transition-colors font-bold" %>
                  </div>
                <% end %>

                <hr class="border-border">

                <%# Suscripción a Alertas %>
                <div class="max-w-md mx-auto space-y-4">
                  <div class="space-y-1">
                    <h4 class="font-bold text-heading text-sm">¿Querés que te avisemos cuando haya eventos similares?</h4>
                    <p class="text-xs text-body-tertiary">Creá una alerta y te notificaremos a tu correo electrónico al instante.</p>
                  </div>

                  <%= form_tag create_alert_events_path, method: :post, class: "flex flex-col sm:flex-row gap-2 mt-3" do %>
                    <%= hidden_field_tag :query, params[:query].presence || "Búsqueda general en #{selected_city_label}" %>
                    <% if current_user.present? %>
                      <%= hidden_field_tag :email, current_user.email %>
                      <button type="submit" class="w-full py-2.5 px-5 bg-primary text-white text-sm font-bold rounded-input hover:bg-primary-hover transition-colors shadow-sm">
                        Notificarme cuando haya eventos de '<%= params[:query].presence || "esta categoría" %>'
                      </button>
                    <% else %>
                      <%= email_field_tag :email, nil, placeholder: "Tu correo electrónico...", required: true,
                          class: "flex-1 border border-border-input rounded-input px-3.5 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-primary font-medium" %>
                      <button type="submit" class="py-2 px-5 bg-primary text-white text-sm font-bold rounded-input hover:bg-primary-hover transition-colors shadow-sm shrink-0">
                        Crear alerta
                      </button>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <%# FALLBACK RECOMENDADOS CONTEXTUALES %>
              <div class="space-y-4">
                <h3 class="text-lg font-bold text-heading flex items-center gap-2">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>Eventos recomendados para vos en <%= selected_city_label %></span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                  <% @fallback_events.each do |event| %>
                    <%= render partial: "events/event_card", locals: { event: event } %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <%# Interactive Map Column (only if events are present) %>
        <% if @events.any? %>
          <div class="col-span-12 lg:col-span-5 hidden lg:block">
            <div class="sticky top-24 h-[calc(100vh-8rem)] rounded-badge border border-border overflow-hidden shadow-sm">
              <%# Actual Leaflet div %>
              <div id="map-canvas" data-explore-target="mapContainer" class="w-full h-full"></div>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>