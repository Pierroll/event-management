<%# Confirmation Code Page %>
<div class="min-h-[80vh] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-heading">Verifica tu correo</h1>
      <p class="mt-2 text-body-tertiary">
        Hemos enviado un código de 6 dígitos a <strong><%= @email %></strong>
      </p>
    </div>

    <div class="bg-white rounded-badge border border-border shadow-raised p-6 md:p-8">
      <%= form_tag verify_confirmation_path, class: "space-y-5" do %>
        <div>
          <%= label_tag :confirmation_code, "Código de verificación", class: "block text-sm font-medium text-body mb-1" %>
          <%= text_field_tag :confirmation_code, nil,
              maxlength: 6,
              inputmode: "numeric",
              pattern: "[0-9]*",
              autocomplete: "one-time-code",
              class: "w-full text-center text-2xl tracking-[0.5em] border border-border-input rounded-input px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary",
              placeholder: "000000",
              required: true %>
        </div>

        <%= submit_tag "Verificar código",
            class: "w-full px-6 py-2.5 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
      <% end %>

      <div class="mt-6 pt-6 border-t border-border text-center">
        <%= form_tag resend_confirmation_path, class: "inline" do %>
          <%= submit_tag "Reenviar código",
              class: "text-sm text-link hover:text-link-hover hover:underline bg-transparent border-none cursor-pointer" %>
        <% end %>
        <p class="text-xs text-muted mt-1">Puedes solicitar un nuevo código cada 60 segundos</p>
      </div>
    </div>
  </div>
</div>
