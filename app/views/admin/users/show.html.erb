<%# Admin User Detail %>
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <%= link_to "← Usuarios", admin_users_path, class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
    <%= link_to "Editar", edit_admin_user_path(@user), class: "px-4 py-2 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
  </div>

  <div class="bg-white rounded-badge border border-border p-6 md:p-8">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-16 h-16 bg-primary/20 rounded-full flex items-center justify-center">
        <span class="text-2xl font-bold text-link-hover"><%= @user.name.first.upcase %></span>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-heading"><%= @user.name %></h1>
        <p class="text-body-tertiary"><%= @user.email %></p>
      </div>
    </div>

    <div class="border-t border-border pt-6 space-y-4">
      <div class="flex justify-between items-center">
        <span class="text-sm text-body-tertiary">Estado</span>
        <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= @user.active ? "bg-success/10 text-success" : "bg-error/10 text-error" %>">
          <%= @user.active ? "Activo" : "Inactivo" %>
        </span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-sm text-body-tertiary">Roles</span>
        <div class="flex gap-1">
          <% @user.roles.each do |role| %>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full
              <%= role.name == "admin" ? "bg-brand-plum/10 text-brand-plum" : "" %>
              <%= role.name == "organizer" ? "bg-success/10 text-success" : "" %>
              <%= role.name == "registered_user" ? "bg-primary/20 text-link" : "" %>">
              <%= role.name.humanize %>
            </span>
          <% end %>
        </div>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-sm text-body-tertiary">Miembro desde</span>
        <span class="text-sm font-medium text-heading"><%= l(@user.created_at, format: :long) %></span>
      </div>
    </div>

    <%# User's Events %>
    <% if @user.organized_events.any? %>
      <div class="mt-8 border-t border-border pt-6">
        <h2 class="text-lg font-semibold text-heading mb-4">Eventos organizados (<%= @user.organized_events.count %>)</h2>
        <div class="space-y-2">
          <% @user.organized_events.each do |event| %>
            <div class="flex items-center justify-between p-3 bg-surface-secondary rounded-card">
              <div>
                <p class="text-sm font-medium text-heading"><%= event.name %></p>
                <p class="text-xs text-body-tertiary"><%= event.city %> · <%= event.status.humanize %></p>
              </div>
              <%= link_to "Ver", admin_event_path(event), class: "text-sm text-link hover:text-link" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>