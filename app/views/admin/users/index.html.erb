<%# Admin Users List %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-heading">Usuarios</h1>
      <p class="mt-1 text-body-tertiary">Gestiona los usuarios del sistema</p>
    </div>
    <%= link_to "← Dashboard", admin_dashboard_path, class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
  </div>

  <div class="bg-white rounded-badge border border-border overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="bg-surface-secondary border-b border-border">
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Usuario</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Email</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Roles</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Estado</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Registro</th>
          <th class="text-right px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @users.each do |user| %>
          <tr class="hover:bg-surface-secondary transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-primary/20 rounded-full flex items-center justify-center">
                  <span class="text-sm font-medium text-link-hover"><%= user.name.first.upcase %></span>
                </div>
                <span class="text-sm font-medium text-heading"><%= user.name %></span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-body-secondary"><%= user.email %></td>
            <td class="px-6 py-4">
              <div class="flex gap-1 flex-wrap">
                <% user.roles.each do |role| %>
                  <span class="px-2 py-0.5 text-xs font-medium rounded-full
                    <%= role.name == "admin" ? "bg-brand-plum/10 text-brand-plum" : "" %>
                    <%= role.name == "organizer" ? "bg-success/10 text-success" : "" %>
                    <%= role.name == "registered_user" ? "bg-primary/20 text-link" : "" %>">
                    <%= role.name.humanize %>
                  </span>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-0.5 text-xs font-medium rounded-full <%= user.active ? "bg-success/10 text-success" : "bg-error/10 text-error" %>">
                <%= user.active ? "Activo" : "Inactivo" %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-body-tertiary"><%= l(user.created_at, format: :short) %></td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "Ver", admin_user_path(user), class: "px-3 py-1.5 text-xs font-medium bg-surface-secondary text-body rounded-card hover:bg-surface-tertiary transition-colors" %>
                <%= link_to "Editar", edit_admin_user_path(user), class: "px-3 py-1.5 text-xs font-medium bg-primary/20 text-link-hover rounded-card hover:bg-primary/30 transition-colors" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @users.total_pages > 1 %>
    <div class="mt-6">
      <%= paginate @users %>
    </div>
  <% end %>
</div>