<%# Admin Category Form Partial %>
<%= form_with model: [:admin, category], local: true, class: "space-y-6" do |f| %>
  <% if category.errors.any? %>
    <div class="bg-error/10 border border-error/30 rounded-card p-4">
      <h3 class="text-sm font-medium text-error">Errores:</h3>
      <ul class="mt-2 list-disc list-inside text-sm text-error">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nombre", class: "block text-sm font-medium text-body mb-1" %>
    <%= f.text_field :name, class: "w-full border border-border-input rounded-input px-4 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
  </div>

  <div>
    <%= f.label :slug, "Slug (identificador URL)", class: "block text-sm font-medium text-body mb-1" %>
    <%= f.text_field :slug, class: "w-full border border-border-input rounded-input px-4 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-primary",
        placeholder: "ej: tecnologia" %>
  </div>

  <div>
    <%= f.label :description, "Descripción", class: "block text-sm font-medium text-body mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full border border-border-input rounded-input px-4 py-2 text-sm focus:ring-2 focus:ring-primary focus:border-primary" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :active, class: "h-4 w-4 text-link focus:ring-primary border-border-input rounded" %>
    <%= f.label :active, "Categoría activa", class: "text-sm font-medium text-body" %>
  </div>

  <div class="flex gap-3 pt-4 border-t border-border">
    <%= f.submit category.new_record? ? "Crear categoría" : "Guardar cambios",
        class: "px-6 py-2 bg-primary text-white text-sm font-medium rounded-card hover:bg-primary-hover transition-colors" %>
    <%= link_to "Cancelar", admin_categories_path, class: "px-6 py-2 border border-border-input text-body text-sm font-medium rounded-card hover:bg-surface-secondary transition-colors" %>
  </div>
<% end %>