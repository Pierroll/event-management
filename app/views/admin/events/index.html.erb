<%# Admin Events List %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-heading">Eventos</h1>
      <p class="mt-1 text-body-tertiary">Gestión absoluta de todos los eventos del sistema</p>
    </div>
    <%= link_to "← Dashboard", admin_dashboard_path, class: "text-sm text-body-tertiary hover:text-body transition-colors" %>
  </div>

  <div class="bg-white rounded-badge border border-border overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="bg-surface-secondary border-b border-border">
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Evento</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Organizador</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Categoría</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Fecha</th>
          <th class="text-left px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Estado</th>
          <th class="text-right px-6 py-3 text-xs font-medium text-body-tertiary uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @events.each do |event| %>
          <tr class="hover:bg-surface-secondary transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-surface-secondary rounded-card overflow-hidden shrink-0">
                  <% if event.event_images.any? %>
                    <%= image_tag event.event_images.first.image_url, class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center text-muted text-xs">📷</div>
                  <% end %>
                </div>
                <span class="text-sm font-medium text-heading"><%= event.name %></span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-body-secondary">
              <div class="flex items-center gap-2">
                <span class="text-xs"><%= event.organizer.name %></span>
                <span class="text-xs text-muted">(<%= event.organizer.email %>)</span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-body-secondary"><%= event.category&.name || "—" %></td>
            <td class="px-6 py-4 text-sm text-body-secondary"><%= l(event.start_date, format: :short) if event.start_date %></td>
            <td class="px-6 py-4">
              <%= event_status_badge(event, classes: "px-2 py-0.5 text-xs font-medium") %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "Ver", admin_event_path(event), class: "px-3 py-1.5 text-xs font-medium bg-primary/20 text-link-hover rounded-card hover:bg-primary/30 transition-colors" %>
                <%= link_to "Editar", edit_admin_event_path(event), class: "px-3 py-1.5 text-xs font-medium bg-warning/10 text-warning rounded-card hover:bg-warning/20 transition-colors" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @events.total_pages > 1 %>
    <div class="mt-6">
      <%= paginate @events %>
    </div>
  <% end %>
</div>