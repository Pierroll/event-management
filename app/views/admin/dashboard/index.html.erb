<%# Admin Dashboard %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-heading">Panel de Administración</h1>
    <p class="mt-1 text-body-tertiary">Resumen general del sistema</p>
  </div>

  <%# Metrics Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-badge border border-border p-6">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-primary/10 rounded-card flex items-center justify-center text-link">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm text-body-tertiary font-medium">Usuarios</p>
          <p class="text-2xl font-bold text-heading"><%= @total_users %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-badge border border-border p-6">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-brand-plum/10 rounded-card flex items-center justify-center text-brand-plum">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm text-body-tertiary font-medium">Eventos totales</p>
          <p class="text-2xl font-bold text-heading"><%= @total_events %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-badge border border-border p-6">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-success/10 rounded-card flex items-center justify-center text-success">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm text-body-tertiary font-medium">Publicados</p>
          <p class="text-2xl font-bold text-heading"><%= @published_events %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-badge border border-border p-6">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-accent/10 rounded-card flex items-center justify-center text-accent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
          </svg>
        </div>
        <div>
          <p class="text-sm text-body-tertiary font-medium">Comentarios</p>
          <p class="text-2xl font-bold text-heading"><%= @total_comments %></p>
        </div>
      </div>
    </div>
  </div>

  <%# Quick Actions %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%= link_to admin_users_path, class: "bg-white rounded-badge border border-border p-6 hover:shadow-md hover:border-primary/30 transition-all group" do %>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-surface-secondary rounded-badge flex items-center justify-center text-muted group-hover:bg-primary/10 group-hover:text-link transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-heading group-hover:text-link-hover transition-colors">Gestionar usuarios</h3>
          <p class="text-sm text-body-tertiary">Ver, editar y asignar roles</p>
        </div>
      </div>
    <% end %>

    <%= link_to admin_events_path, class: "bg-white rounded-badge border border-border p-6 hover:shadow-md hover:border-primary/30 transition-all group" do %>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-surface-secondary rounded-badge flex items-center justify-center text-muted group-hover:bg-success/10 group-hover:text-success transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-heading group-hover:text-success transition-colors">Gestionar eventos</h3>
          <p class="text-sm text-body-tertiary">Moderar y cambiar estados</p>
        </div>
      </div>
    <% end %>

    <%= link_to admin_categories_path, class: "bg-white rounded-badge border border-border p-6 hover:shadow-md hover:border-primary/30 transition-all group" do %>
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-surface-secondary rounded-badge flex items-center justify-center text-muted group-hover:bg-accent/10 group-hover:text-accent transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-heading group-hover:text-accent transition-colors">Gestionar categorías</h3>
          <p class="text-sm text-body-tertiary">Crear y editar categorías</p>
        </div>
      </div>
    <% end %>
  </div>
</div>