<% content_for :disable_footer_margin, "true" %>
<div class="flex flex-col md:flex-row min-h-screen">
  <%# Sidebar Izquierdo (Navegación) %>
  <aside class="w-full md:w-64 lg:w-72 border-r border-border-light bg-surface flex-shrink-0 hidden md:block">
    <div class="p-6 sticky top-20">
      <h3 class="text-[10px] font-black uppercase tracking-widest text-muted mb-4">AUTENTICACIÓN</h3>
      <nav class="space-y-1 mb-8">
        <a href="#api-key" class="block px-3 py-2.5 text-sm font-bold text-body-tertiary hover:bg-surface-secondary hover:text-body rounded-lg transition-colors">Credenciales (API Key)</a>
      </nav>

      <h3 class="text-[10px] font-black uppercase tracking-widest text-muted mb-4">ENDPOINTS B2B</h3>
      <nav class="space-y-1">
        <a href="#video-tutorial" class="block px-3 py-2.5 text-sm font-bold text-body-tertiary hover:bg-surface-secondary hover:text-body rounded-lg transition-colors">Video Tutorial</a>
        <a href="#consulta-eventos" class="block px-3 py-2.5 text-sm font-bold text-link bg-primary/5 rounded-lg transition-colors">Consulta Eventos</a>
        <a href="#aforo" class="block px-3 py-2.5 text-sm font-bold text-body-tertiary hover:bg-surface-secondary hover:text-body rounded-lg transition-colors">Disponibilidad y Aforo</a>
        <a href="#" class="block px-3 py-2.5 text-sm font-bold text-muted cursor-not-allowed rounded-lg opacity-70">Directorio Organizadores (Próximamente)</a>
      </nav>
    </div>
  </aside>

  <%# Columna Central (Contenido Principal) %>
  <main class="flex-1 px-4 sm:px-8 lg:px-16 xl:px-24 py-10 pb-32 overflow-x-hidden max-w-4xl mx-auto md:mx-0 md:max-w-none">
    
    <div class="mb-12">
      <h1 class="text-3xl lg:text-4xl font-display font-black text-heading tracking-tight">API Reference</h1>
      <p class="text-body-secondary mt-3 text-lg max-w-2xl">Integra el catálogo global de eventos de Actify en tu sistema mediante nuestra API RESTful pública, segura y rápida.</p>
    </div>
    
    <%# 1. API Key Section %>
    <section id="api-key" class="mb-16 scroll-mt-24">
      <h2 class="text-2xl font-black text-heading mb-4 pb-2 border-b border-border-light">Autenticación y Límites</h2>
      <p class="text-body mb-6">Actify utiliza tokens al portador (Bearer Tokens) para autenticar las solicitudes. Debes enviar tu API Key en el header <code class="bg-surface-secondary px-1.5 py-0.5 rounded text-xs font-mono">Authorization</code> en cada petición.</p>
      
      <div class="bg-surface border border-border-light rounded-2xl p-6 shadow-sm mb-8">
        <label class="block text-sm font-bold text-heading mb-3">Tu API Key (Bearer Token)</label>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <div class="relative flex-1">
            <input type="text" readonly value="<%= current_user.api_token || 'Token no generado aún' %>" 
                   class="w-full bg-surface-sunken border border-border/50 rounded-xl px-4 py-3 font-mono text-sm text-body-primary font-medium focus:outline-none focus:ring-2 focus:ring-primary/20" onclick="this.select();" />
          </div>
          <%= button_to "Regenerar Key", regenerate_api_token_developers_portal_path, method: :post, 
              data: { turbo_confirm: "¡ATENCIÓN! Cualquier aplicación que use tu llave actual dejará de funcionar inmediatamente. ¿Estás seguro de continuar?" },
              class: "btn-secondary py-3 flex-shrink-0 whitespace-nowrap" %>
        </div>
      </div>

      <h3 class="text-lg font-bold text-heading mb-4">Límites de Uso (Rate Limiting)</h3>
      <p class="text-body mb-4">La API implementa límites de peticiones para garantizar la estabilidad de la plataforma.</p>
      <div class="overflow-x-auto border border-border-light rounded-xl">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-secondary border-b border-border-light">
            <tr>
              <th class="px-4 py-3 font-black text-body-secondary">Límite</th>
              <th class="px-4 py-3 font-black text-body-secondary">Descripción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-light">
            <tr class="hover:bg-surface-secondary/30 transition-colors">
              <td class="px-4 py-3 font-mono text-body-secondary">100 peticiones / min</td>
              <td class="px-4 py-3 text-body">Si superas este límite, recibirás un error <code class="text-xs font-mono">429 Too Many Requests</code>.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <%# 2. List Events %>
    <section id="list-events" class="mb-16 scroll-mt-24">
      <h2 class="text-2xl font-black text-heading mb-4 pb-2 border-b border-border-light">Listar Eventos</h2>
      <p class="text-body mb-6">Obtén el catálogo global de eventos publicados, con soporte para paginación y filtros.</p>
      
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-8">
        <span class="px-2.5 py-1 text-[11px] font-black uppercase tracking-widest text-green-700 bg-green-100 rounded-md inline-flex self-start">GET</span>
        <div class="bg-surface-sunken border border-border/50 px-3 py-1.5 rounded-lg flex-1 overflow-x-auto flex items-center justify-between group">
          <code class="text-sm font-mono text-body-secondary"><span class="text-muted">https://actify.qd.je</span>/api/v1/events</code>
          <button class="text-muted hover:text-link transition-colors opacity-0 group-hover:opacity-100" onclick="navigator.clipboard.writeText('https://actify.qd.je/api/v1/events')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </button>
        </div>
      </div>

      <h3 class="text-lg font-bold text-heading mb-4">Query Parameters</h3>
      <div class="overflow-x-auto border border-border-light rounded-xl mb-8">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-secondary border-b border-border-light">
            <tr>
              <th class="px-4 py-3 font-black text-body-secondary">Parámetro</th>
              <th class="px-4 py-3 font-black text-body-secondary">Tipo</th>
              <th class="px-4 py-3 font-black text-body-secondary">Descripción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-light">
            <tr class="hover:bg-surface-secondary/30 transition-colors">
              <td class="px-4 py-3 font-mono text-body-secondary">page</td>
              <td class="px-4 py-3 text-body-tertiary">integer</td>
              <td class="px-4 py-3 text-body">Número de página para la paginación.</td>
            </tr>
            <tr class="hover:bg-surface-secondary/30 transition-colors">
              <td class="px-4 py-3 font-mono text-body-secondary">category_id</td>
              <td class="px-4 py-3 text-body-tertiary">integer</td>
              <td class="px-4 py-3 text-body">Filtra eventos por categoría específica.</td>
            </tr>
            <tr class="hover:bg-surface-secondary/30 transition-colors">
              <td class="px-4 py-3 font-mono text-body-secondary">location</td>
              <td class="px-4 py-3 text-body-tertiary">string</td>
              <td class="px-4 py-3 text-body">Busca eventos cerca de esta ciudad o dirección.</td>
            </tr>
            <tr class="hover:bg-surface-secondary/30 transition-colors">
              <td class="px-4 py-3 font-mono text-body-secondary">radius</td>
              <td class="px-4 py-3 text-body-tertiary">integer</td>
              <td class="px-4 py-3 text-body">Radio en km para la búsqueda por location (por defecto 50).</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-lg font-bold text-heading mb-4">Respuesta de Ejemplo</h3>
      <div class="bg-[#1e1e2e] text-[#a6accd] rounded-xl overflow-hidden shadow-lg border border-gray-800/50 mb-12">
        <div class="flex items-center justify-between px-4 py-2 border-b border-gray-700/50 bg-[#181825]">
          <span class="text-xs font-mono font-bold text-gray-400">Response (200 OK)</span>
        </div>
        <div class="p-4 overflow-x-auto custom-scrollbar">
          <pre class="text-xs font-mono leading-relaxed"><code>[
  {
    <span class="text-[#89ddff]">"id"</span>: <span class="text-[#f78c6c]">1</span>,
    <span class="text-[#89ddff]">"name"</span>: <span class="text-[#c3e88d]">"Congreso de Turismo Sostenible"</span>,
    <span class="text-[#89ddff]">"status"</span>: <span class="text-[#c3e88d]">"published"</span>,
    <span class="text-[#89ddff]">"capacity"</span>: {
      <span class="text-[#89ddff]">"max_capacity"</span>: <span class="text-[#f78c6c]">500</span>,
      <span class="text-[#89ddff]">"is_sold_out"</span>: <span class="text-[#89ddff]">false</span>
    },
    <span class="text-[#89ddff]">"location"</span>: {
      <span class="text-[#89ddff]">"city"</span>: <span class="text-[#c3e88d]">"Tingo María"</span>
    },
    <span class="text-[#89ddff]">"image_url"</span>: <span class="text-[#c3e88d]">"/rails/active_storage/blobs/redirect/.../imagen.jpg"</span>
  }
]</code></pre>
        </div>
      </div>
    </section>

    <%# 3. Retrieve Event %>
    <section id="retrieve-event" class="mb-16 scroll-mt-24">
      <h2 class="text-2xl font-black text-heading mb-4 pb-2 border-b border-border-light">Obtener un Evento</h2>
      <p class="text-body mb-6">Recupera los detalles completos de un evento específico, incluyendo aforo en vivo y tipos de entrada.</p>
      
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-8">
        <span class="px-2.5 py-1 text-[11px] font-black uppercase tracking-widest text-green-700 bg-green-100 rounded-md inline-flex self-start">GET</span>
        <div class="bg-surface-sunken border border-border/50 px-3 py-1.5 rounded-lg flex-1 overflow-x-auto flex items-center justify-between group">
          <code class="text-sm font-mono text-body-secondary"><span class="text-muted">https://actify.qd.je</span>/api/v1/events/:id</code>
        </div>
      </div>

      <h3 class="text-lg font-bold text-heading mb-4">Path Parameters</h3>
      <div class="overflow-x-auto border border-border-light rounded-xl mb-8">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-secondary border-b border-border-light">
            <tr>
              <th class="px-4 py-3 font-black text-body-secondary">Parámetro</th>
              <th class="px-4 py-3 font-black text-body-secondary">Tipo</th>
              <th class="px-4 py-3 font-black text-body-secondary">Descripción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-light">
            <tr class="hover:bg-surface-secondary/30 transition-colors">
              <td class="px-4 py-3 font-mono text-body-secondary">id</td>
              <td class="px-4 py-3 text-body-tertiary">integer</td>
              <td class="px-4 py-3 text-body">El identificador único del evento.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-lg font-bold text-heading mb-4">Respuesta de Ejemplo</h3>
      <div class="bg-[#1e1e2e] text-[#a6accd] rounded-xl overflow-hidden shadow-lg border border-gray-800/50 mb-12">
        <div class="flex items-center justify-between px-4 py-2 border-b border-gray-700/50 bg-[#181825]">
          <span class="text-xs font-mono font-bold text-gray-400">Response (200 OK)</span>
        </div>
        <div class="p-4 overflow-x-auto custom-scrollbar">
          <pre class="text-xs font-mono leading-relaxed"><code>{
  <span class="text-[#89ddff]">"id"</span>: <span class="text-[#f78c6c]">1</span>,
  <span class="text-[#89ddff]">"name"</span>: <span class="text-[#c3e88d]">"Congreso de Turismo Sostenible"</span>,
  <span class="text-[#89ddff]">"description"</span>: <span class="text-[#c3e88d]">"Un congreso mundial sobre sustentabilidad..."</span>,
  <span class="text-[#89ddff]">"capacity"</span>: {
    <span class="text-[#89ddff]">"max_capacity"</span>: <span class="text-[#f78c6c]">2500</span>,
    <span class="text-[#89ddff]">"sold_tickets"</span>: <span class="text-[#f78c6c]">1840</span>,
    <span class="text-[#89ddff]">"available_spots"</span>: <span class="text-[#f78c6c]">660</span>,
    <span class="text-[#89ddff]">"is_sold_out"</span>: <span class="text-[#89ddff]">false</span>
  },
  <span class="text-[#89ddff]">"ticket_types"</span>: [
    {
      <span class="text-[#89ddff]">"name"</span>: <span class="text-[#c3e88d]">"Entrada VIP"</span>,
      <span class="text-[#89ddff]">"price"</span>: <span class="text-[#f78c6c]">150.0</span>,
      <span class="text-[#89ddff]">"currency"</span>: <span class="text-[#c3e88d]">"PEN"</span>
    }
  ],
  <span class="text-[#89ddff]">"image_url"</span>: <span class="text-[#c3e88d]">"/rails/active_storage/blobs/redirect/.../evento.jpg"</span>
}</code></pre>
        </div>
      </div>
    </section>
  </main>

  <%# Sidebar Derecho (Tabla de Contenidos) %>
  <aside class="hidden xl:block w-64 border-l border-border-light flex-shrink-0 pt-12 px-6">
    <div class="sticky top-28">
      <h4 class="text-[10px] font-black uppercase tracking-widest text-heading mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
        EN ESTA PÁGINA
      </h4>
      <nav class="space-y-3 text-sm font-bold">
        <a href="#api-key" class="block text-body-tertiary hover:text-link transition-colors">Autenticación y Límites</a>
        <a href="#list-events" class="block text-body-tertiary hover:text-link transition-colors">Listar Eventos</a>
        <a href="#retrieve-event" class="block text-body-tertiary hover:text-link transition-colors">Obtener un Evento</a>
      </nav>
    </div>
  </aside>
</div>
